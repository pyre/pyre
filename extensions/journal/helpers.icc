// code guard
#pragma once


// my declarations
#include "helpers.h"


// build a locator that points to the nearest caller from python
auto
pyre::journal::py::locator() -> locator_t
{
    // get the frame of our caller; the call to the bindings does not add a frame of its own,
    // so the innermost python frame is the caller's. a stack trace would also read the text of
    // the line from the source file, which is never used
    auto frame = py::module::import("sys").attr("_getframe")(0);
    // get its code
    auto code = frame.attr("f_code");
    // pull out what we need
    py::str filename = code.attr("co_filename");
    py::str line = frame.attr("f_lineno");
    py::str function = code.attr("co_name");

    // make a locator
    locator_t loc(filename, line, function);

    // and return it
    return loc;
}


// build the python counterpart of a journal exception
template <class errorT>
auto
pyre::journal::py::complaint(const char * type, const errorT & error) -> py::object
{
    // get the exception class
    auto cls = py::module::import("journal.exceptions").attr(type);
    // copy the page into a list, since the bound page is opaque
    py::list page;
    // one line at a time
    for (const auto & line : error.page()) {
        // add it to the pile
        page.append(line);
    }
    // copy the notes into a dictionary, for the same reason
    py::dict notes;
    // one pair at a time
    for (const auto & [key, value] : error.notes()) {
        // add it to the pile
        notes[py::str(key)] = value;
    }
    // look up the name of the channel that raised it
    auto name = error.notes().find("channel");
    // if it's not there, the channel is anonymous
    auto channel = (name != error.notes().end()) ? py::object(py::str(name->second)) : py::none();
    // build the exception and hand it off
    return cls(
        "headline"_a = error.what(), "channel"_a = channel, "page"_a = page, "notes"_a = notes);
}


