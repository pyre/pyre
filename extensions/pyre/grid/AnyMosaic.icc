// code guard
#pragma once


// support
#include "AnyMosaic.h"


// type-erase a mosaic into the single class the bindings expose
template <class gridT>
auto
pyre::py::grid::anyMosaic(const gridT & mosaic, string_t cell) -> AnyMosaic
{
    // keep a copy of the source grid alive behind a shared handle: its storage shares the page
    // table, so every page stays put for as long as any of the closures below is callable
    auto owner = std::make_shared<gridT>(mosaic);
    // pull the layout out while its type is concrete; it travels by value
    auto packing = owner->packing();
    // and the storage, whose copies are views of the same store
    auto storage = owner->storage();

    // count the resident pages
    AnyMosaic::census_type residents = [storage]() -> AnyMosaic::size_type {
        // the store keeps the census
        return storage.residents();
    };

    // carve the pane over one tile
    AnyMosaic::pane_maker_type pane = [owner](const AnyMosaic::index_type & t) -> AnyGrid {
        // materialize the tile's page, allocating it on first touch; this is the demand-driven
        // half of the out-of-core workflow
        owner->storage().reside(owner->packing().tileOrdinal(t));
        // carve the pane: a dense grid over the page, addressed in the mosaic's index space
        auto pane = owner->pane(t);
        // describe it to python over the page's block; the owner handle pins the whole store,
        // which is safe precisely because residency is monotonic: a pinned store never moves
        // or reclaims a page
        return describe(pane, "pane", pane.data(), owner);
    };

    // read the page state bits
    AnyMosaic::probe_type resident = [storage](AnyMosaic::size_type ordinal) -> bool {
        // whether the page has been allocated
        return storage.resident(ordinal);
    };
    AnyMosaic::probe_type valid = [storage](AnyMosaic::size_type ordinal) -> bool {
        // whether the client has deposited meaningful content
        return storage.valid(ordinal);
    };
    AnyMosaic::probe_type clean = [storage](AnyMosaic::size_type ordinal) -> bool {
        // whether the content matches the client's backing store
        return storage.clean(ordinal);
    };

    // and flip them
    AnyMosaic::mark_type validate = [storage](AnyMosaic::size_type ordinal) -> void {
        // the page now holds meaningful content
        storage.validate(ordinal);
    };
    AnyMosaic::mark_type taint = [storage](AnyMosaic::size_type ordinal) -> void {
        // the page has diverged from the backing store
        storage.taint(ordinal);
    };
    AnyMosaic::mark_type flush = [storage](AnyMosaic::size_type ordinal) -> void {
        // the page matches the backing store again
        storage.flush(ordinal);
    };

    // name the cell type while it is still concrete, in its writable spelling
    using cell_t = std::remove_const_t<typename gridT::value_type>;

    // lift the cell at an index into python; the caller has verified that its page is resident
    AnyMosaic::reader_type read = [owner](const AnyMosaic::index_type & index) -> py::object {
        // pull the cell through the mosaic's own map and cast it across
        return py::cast((*owner)[index]);
    };
    // deposit a python value into the cell at an index, its companion
    AnyMosaic::writer_type write =
        [owner](const AnyMosaic::index_type & index, const py::object & value) -> void {
        // the page that holds the cell
        auto ordinal = owner->packing().tileOrdinal(owner->packing().tileOf(index));
        // materialize it, in case this is its first touch
        owner->storage().reside(ordinal);
        // deposit the converted value through the mosaic's own map
        (*owner)[index] = value.cast<cell_t>();
        // the write is a divergence this closure can see, so record it
        owner->storage().taint(ordinal);
    };

    // assemble the type-erased mosaic
    return AnyMosaic(
        // the layout
        std::move(packing),
        // the name of the cell type
        std::move(cell),
        // the census
        std::move(residents),
        // the pane maker
        std::move(pane),
        // the page state probes
        std::move(resident), std::move(valid), std::move(clean),
        // the page state marks
        std::move(validate), std::move(taint), std::move(flush),
        // and the pair that moves a cell to and from python
        std::move(read), std::move(write));
}


// end of file
