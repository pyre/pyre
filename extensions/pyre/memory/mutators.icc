// code guard
#pragma once


// declarations
#include "mutators.h"


// decorator that adds the write access common to all writable storage strategies
template <class memT>
auto
pyre::py::memory::mutators(pymem_t<memT> & cls) -> void
{
    // alias the storage strategy
    using mem_t = memT;
    // the position of a cell, signed so that a negative one reaches the bounds check as such
    using index_t = typename mem_t::difference_type;
    // the native scalar behind the cell, which is what python hands over; a byte ordered cell
    // swaps on the way in
    using native_t = pyre::memory::native_t<typename mem_t::value_type>;

    // write access to a single cell
    cls.def(
        // the name
        "__setitem__",
        // the implementation
        [](mem_t & self, index_t index, native_t value) -> void {
            // store {value} in the cell at {index}
            self.at(index) = value;
            // all done
            return;
        },
        // the signature
        "index"_a, "value"_a,
        // the docstring
        "store {value} in the cell at {index}");

    // all done
    return;
}


// end of file
