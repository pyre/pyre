// code guard
#pragma once


// declarations
#include "accessors.h"


// decorator that adds the read access common to all storage strategies
template <class memT>
auto
pyre::py::memory::accessors(pymem_t<memT> & cls) -> void
{
    // alias the storage strategy
    using mem_t = memT;
    // the position of a cell, signed so that a negative one reaches the bounds check as such
    using index_t = typename mem_t::difference_type;
    // views derived from the storage
    using view_t = pyre::memory::View<typename mem_t::value_type, mem_t::readonly()>;
    // the native scalar behind the cell, which is what python sees; a byte ordered cell swaps on
    // the way through, so python never meets the wrapper
    using native_t = pyre::memory::native_t<typename mem_t::value_type>;

    // the size
    cls.def(
        // the name
        "__len__",
        // the implementation
        &mem_t::cells,
        // the docstring
        "the number of data cells");

    // iteration over the cells
    cls.def(
        // the name
        "__iter__",
        // the implementation
        [](const mem_t & self) {
            // make an iterator that lifts each cell to its native value, and return it
            return py::make_iterator<
                py::return_value_policy::reference_internal, decltype(self.begin()),
                decltype(self.end()), native_t>(self.begin(), self.end());
        },
        // keep the storage around while its iterator is in use
        py::keep_alive<0, 1>(),
        // the docstring
        "visit my cells in order");

    // read access to a single cell
    cls.def(
        // the name
        "__getitem__",
        // the implementation
        [](const mem_t & self, index_t index) -> native_t {
            // lift the cell at {index} to its native value, and return it
            return self.at(index);
        },
        // the signature
        "index"_a,
        // the docstring
        "the value of the cell at {index}");

    // and to a range of cells
    cls.def(
        // the name
        "__getitem__",
        // the implementation
        [](const mem_t & self, py::slice slice) -> view_t {
            // resolve {slice} against my extent
            auto start = std::size_t(0);
            auto stop = std::size_t(0);
            auto step = std::size_t(0);
            auto span = std::size_t(0);
            auto status = slice.compute(self.cells(), &start, &stop, &step, &span);
            // if that fails
            if (!status) {
                // bail; pybind11 has already registered the correct exception
                throw py::error_already_set();
            }
            // build a view over the selected cells, and return it
            return view_t(self.data() + start, span, step);
        },
        // the signature
        "slice"_a,
        // the docstring
        "a view over the cells selected by {slice}");

    // all done
    return;
}


// end of file
