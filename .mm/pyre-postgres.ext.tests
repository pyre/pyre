# the postgres extension testsuite
pyre-postgres.ext.tests.stem := postgres.ext
pyre-postgres.ext.tests.prerequisites := pyre-postgres.ext journal.pkg pyre.pkg


# skip the whole suite when no server is reachable
pyre-postgres.ext.tests.drivers.exclude := \
    ${if $(postgres.live),,${notdir ${wildcard tests/postgres.ext/*.py}}}


# end of file
