# the pyre extension module test suite
pyre.ext.tests.stem := pyre.ext
pyre.ext.tests.prerequisites := pyre.ext


# clean up
# the drivers leave their scratch products behind so they can be inspected; the harness
# sweeps them
tests.pyre.ext.grid.map.clean := grid_map_test.dat
tests.pyre.ext.grid.readonly.clean := grid_readonly_test.dat


