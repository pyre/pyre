# the {rolling-clang} image: the latest ubuntu release, apt-provided clang toolchain, native packages
pyre.rolling-clang.name := rolling-clang
pyre.rolling-clang.root := etc/docker/

# {mm} and {pyre} both live one level above the pyre home; bind-mount that parent so the image
# builds and tests the live working tree; defer expansion so {pyre.home} is read at mount time
pyre.rolling-clang.mounts.source = ${realpath $(pyre.home)/..}/
# mount both the build tool and the sources for {.run} and {.launch}
pyre.rolling-clang.mounts := mm pyre


