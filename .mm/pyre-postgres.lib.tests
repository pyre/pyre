# the postgres library testsuite
pyre-postgres.lib.tests.stem := postgres.lib
pyre-postgres.lib.tests.prerequisites := pyre-postgres.lib
pyre-postgres.lib.tests.extern := pyre-postgres.lib journal.lib libpq

# c++ compiler arguments
pyre-postgres.lib.tests.c++.defines += $(pyre.lib.c++.defines)
pyre-postgres.lib.tests.c++.flags += -Wall $(pyre.lib.c++.flags)


# every driver below {sanity} needs a live server, and they all talk to the same one; the ones
# that create objects do so in the temporary schema of their own session, so they do not collide
# with each other and they leave nothing behind. they run in order, the simplest first, so that
# the first failure points at the most basic thing that is broken
# skip the whole suite when no server is reachable
pyre-postgres.lib.tests.drivers.exclude := \
    ${if $(postgres.live),,${notdir ${wildcard tests/postgres.lib/*.cc}}}


tests.postgres.lib.connect.pre := tests.postgres.lib.sanity
tests.postgres.lib.exec.pre := tests.postgres.lib.connect
tests.postgres.lib.codecs.pre := tests.postgres.lib.exec
tests.postgres.lib.errors.pre := tests.postgres.lib.codecs
tests.postgres.lib.transaction.pre := tests.postgres.lib.errors
tests.postgres.lib.async.pre := tests.postgres.lib.transaction
tests.postgres.lib.transaction_aborted.pre := tests.postgres.lib.async
tests.postgres.lib.threads.pre := tests.postgres.lib.transaction_aborted

# the threads that share a session need the thread library, which older linux systems keep apart
tests.postgres.lib.threads.libraries := pthread
tests.postgres.lib.copy_threads.libraries := pthread
tests.postgres.lib.hold_threads.libraries := pthread


# end of file
