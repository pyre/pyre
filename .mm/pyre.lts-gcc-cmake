# the {lts-gcc-cmake} image: the current ubuntu LTS and its gcc toolchain, building with cmake
pyre.lts-gcc-cmake.name := lts-gcc-cmake
pyre.lts-gcc-cmake.root := etc/docker/

# the sources live one level above the pyre home; bind-mount that parent so the image builds and
# tests the live working tree; defer expansion so {pyre.home} is read at mount time
pyre.lts-gcc-cmake.mounts.source = ${realpath $(pyre.home)/..}/
# cmake drives this build, so only the sources are needed for {.run} and {.launch}
pyre.lts-gcc-cmake.mounts := pyre


