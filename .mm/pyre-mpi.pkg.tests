# {serial} runs as is
# {parallel} has a harness
tests.pyre-mpi.pkg.group_setops.parallel.harness = $(pyre-mpi.pkg.harness) -np 7

# {restrict} has cases; note that the driver is {restrict.py}, so this is the name the engine
# derives for the target, and the one the {.pre} chain above already uses
tests.mpi.pkg.restrict.cases := \
    tests.pyre-mpi.pkg.restrict.serial tests.pyre-mpi.pkg.restrict.parallel
# {serial} runs as is
# {parallel} has a harness
tests.pyre-mpi.pkg.restrict.parallel.harness = $(pyre-mpi.pkg.harness) -np 7


