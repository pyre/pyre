# the h5 extension testsuite
pyre-h5.ext.tests.stem := h5.ext
pyre-h5.ext.tests.prerequisites := pyre-h5.ext pyre.pkg pyre.ext


# clean up
# the drivers leave their scratch products behind so they can be inspected; the harness
# sweeps them
tests.h5.ext.mosaic.clean := h5_ext_mosaic.h5
tests.h5.ext.dcpl_fill.clean := h5_ext_dcpl_fill.h5


# end of file
