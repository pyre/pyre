; for the application in {mpirun.py}
mpi.application # mpirun:
  shell = mpi.mpirun
  shell.tasks = 4
  shell.hostfile = localhost
  ; skip process binding so the launch fits machines with fewer cores than tasks, the same
  ; accommodation the harnessed parallel tests make
  shell.extra = --bind-to none
  ; shell.extra = -mca mpi_show_mca_params enviro


; for the application in {slurm.py}
mpi.application # slurm:
  shell = mpi.slurm
  shell.tasks = 8
  shell.queue = batch
  ; shell.submit = no

; end of file
