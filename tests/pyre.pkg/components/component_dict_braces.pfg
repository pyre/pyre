; an empty map, the way a dictionary renders
pfgempty:
  selection = {}

; a whole map, in its text form, with a value that holds braces
pfgtext:
  selection = band:{{L}}
  label = {{L}}

; the same map, one key at a time
pfgkeys:
  selection:
    band = {{L}}


; end of file
