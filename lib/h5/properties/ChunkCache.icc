#include "ChunkCache.h"


// make a chunk cache description
inline pyre::h5::properties::ChunkCache::ChunkCache(
    std::size_t slots, std::size_t bytes, double preemption) :
    // record the size of the index
    slots(slots),
    // the memory budget
    bytes(bytes),
    // and the eviction policy
    preemption(preemption)
{}


