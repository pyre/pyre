#include "Sizes.h"


// describe the widths hdf5 records positions and lengths in
inline pyre::h5::properties::Sizes::Sizes(std::size_t offsets, std::size_t lengths) :
    // record how many bytes a position in the file takes
    offsets(offsets),
    // then how many bytes a length takes
    lengths(lengths)
{}


