// code guard
#pragma once

// my declarations
#include "Identifier.h"


// my raw hdf5 handle
inline auto
pyre::h5::Identifier::id() const -> id_type
{
    // hand off my handle
    return _id;
}


// whether my handle refers to a live hdf5 object
inline auto
pyre::h5::Identifier::valid() const -> bool
{
    // a negative handle is the library's own way of saying there is no object; answer
    // without asking, since every call into the library clears its error stack, and the
    // reasons for a failed open must survive the temporaries that carry the empty handle
    if (_id < 0) {
        // so it is not live
        return false;
    }
    // otherwise, ask the library; a positive answer means the handle is live
    return H5Iis_valid(_id) > 0;
}


// the number of outstanding references to my handle
inline auto
pyre::h5::Identifier::refcount() const -> int
{
    // a dead handle has no references
    if (!valid()) {
        // so say so
        return 0;
    }
    // ask the library; a handle it will not count has no references either, so a refusal is
    // the caller's answer
    auto count = H5Iget_ref(_id);
    // report it, clamped so a refusal never reads as a count
    return count < 0 ? 0 : count;
}


// contextual conversion to {bool}
inline pyre::h5::Identifier::
operator bool() const
{
    // i am truthy when i refer to a live object
    return valid();
}


// take out a reference to my handle, if it is live
inline auto
pyre::h5::Identifier::_retain() const -> void
{
    // a dead handle has nothing to retain
    if (!valid()) {
        // so there is nothing to do
        return;
    }
    // otherwise, increment the library's reference count
    if (H5Iinc_ref(_id) < 0) {
        // a failure here means the handle bookkeeping is inconsistent: a bug
        auto channel = pyre::journal::firewall_t("pyre.h5.identifier");
        // so complain
        channel
            // mark
            << pyre::journal::at()
            // what
            << "failed to retain the hdf5 handle "
            << _id
            // flush
            << pyre::journal::endl;
    }
    // all done
    return;
}


// end of file
