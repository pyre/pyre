// code guard
#pragma once


// my declarations
#include "Stream.h"


// metamethods
// start {statement} on {connection}, and ask for its rows {batch} at a time
pyre::postgres::Stream::Stream(
    connection_type connection, view_t statement, const arguments_type & arguments, int batch) :
    _connection(std::move(connection)),
    // keep the other threads off the session until the last row is read, and start only on a
    // session that is not in the middle of another answer
    _guard(_connection._free(statement)),
    _statement(statement),
    _batch(batch),
    // where the session stands decides how an abandoned stream is stopped
    _transaction(_connection.transaction() != TransactionStatus::idle),
    // not yet; the statement has to go out first
    _live(false)
{
    // a failure below throws, and leaves me unbuilt: my destructor will not run, but my guard
    // goes away with the rest of what was built, and lets go of the session. a batch of no rows
    // is a mistake of the caller
    if (_batch < 1) {
        // caught before anything is sent
        throw InterfaceError(Diagnostic(
            "a stream reads the rows of its statement at least one at a time", _statement));
    }
    // send the statement off, with its arguments
    _connection.sendParams(_statement, arguments);
    // from here on, the answer is under way
    _live = true;
    // ask libpq to hand the rows over in batches
#if defined(LIBPQ_HAS_CHUNK_MODE)
    const auto batches = PQsetChunkedRowsMode(_connection._handle(), _batch);
    // or, before libpq 17, one at a time
#else
    const auto batches = PQsetSingleRowMode(_connection._handle());
#endif
    // libpq refuses only when the statement did not just go out, which cannot happen here
    if (batches == 0) {
        // but if it does, the answer is stopped
        _close();
        // and the refusal reported
        throw InterfaceError(Diagnostic(
            "libpq would not hand over the rows of the statement in batches", _statement));
    }

    // all done
    return;
}


// the duty to end it may be passed along
pyre::postgres::Stream::Stream(Stream && other) noexcept :
    _connection(std::move(other._connection)),
    _guard(std::move(other._guard)),
    _statement(std::move(other._statement)),
    _batch(other._batch),
    _transaction(other._transaction),
    _live(other._live)
{
    // whoever we took it from no longer owes the server an end
    other._live = false;
}


pyre::postgres::Stream &
pyre::postgres::Stream::operator=(Stream && other) noexcept
{
    // guard against a self assignment, which would end the stream and then adopt what is left of
    // it
    if (this == &other) {
        return *this;
    }

    // whatever i am holding has to be ended before i let go of it
    _close();
    // take the session
    _connection = std::move(other._connection);
    // the hold on its lock
    _guard = std::move(other._guard);
    // the statement
    _statement = std::move(other._statement);
    // the size of the batches
    _batch = other._batch;
    // where the session stood
    _transaction = other._transaction;
    // and the duty
    _live = other._live;
    // which the other one no longer has
    other._live = false;

    // all done
    return *this;
}


// and whoever ends up holding it stops the answer, unless all the rows are read
pyre::postgres::Stream::~Stream()
{
    // a stream still under way at the end of my scope is one whose caller wanted no more rows
    _close();
}


// interface
// the next batch of rows, or nothing once they are all read
auto
pyre::postgres::Stream::next() -> std::optional<result_type>
{
    // a stream that has ended
    if (!_live) {
        // has no more rows
        return std::optional<result_type>();
    }

    // wait for the next part of the answer
    PGresult * result = PQgetResult(_connection._handle());
    // an answer that ends before the server says how it went
    if (result == nullptr) {
        // means libpq lost the session; the session explains why, and the answer is over
        // however that goes
        try {
            // so ask it
            _connection._fail(_statement);
        }
        // and let go of the session before the explanation goes on its way
        catch (...) {
            // end the stream
            _end();
            // and let it go
            throw;
        }
    }

    // take ownership, so that whatever happens next the result gets freed
    const Result answer(result);
    // the status of the answer
    const auto status = answer.status();
    // a batch of rows
    if (status == ExecStatus::chunk || status == ExecStatus::singleTuple) {
        // is handed over
        return std::optional<result_type>(answer);
    }
    // a copy, whose rows travel through {CopyIn} and {CopyOut}
    if (status == ExecStatus::copyIn || status == ExecStatus::copyOut
        || status == ExecStatus::copyBoth) {
        // is ended, and refused, which ends the answer however that goes
        try {
            // refuse it
            _connection._refuse(status, _statement);
        }
        // and let go of the session before the refusal goes on its way
        catch (...) {
            // end the stream
            _end();
            // and let it go
            throw;
        }
    }

    // anything else is the end of the answer; collect what is left of it, which a selection
    // does not have, so that the session can be used again
    while (PGresult * extra = PQgetResult(_connection._handle())) {
        // throw it away
        PQclear(extra);
    }
    // the answer is over
    _end();
    // a server that failed to make every row
    if (!answer.ok()) {
        // says why, as the condition it named
        answer.raise(_statement);
    }

    // otherwise, the rows are all read
    return std::optional<result_type>();
}


// whether there may be rows still to come
auto
pyre::postgres::Stream::live() const -> bool
{
    // easy enough
    return _live;
}


// the statement that started me
auto
pyre::postgres::Stream::statement() const -> view_t
{
    // easy enough
    return _statement;
}


// the number of rows i asked for in each batch
auto
pyre::postgres::Stream::batch() const -> int
{
    // easy enough
    return _batch;
}


// implementation details
// the answer is over: let go of the session
auto
pyre::postgres::Stream::_end() -> void
{
    // there are no more rows
    _live = false;
    // and the other threads may use the session again
    _guard.unlock();

    // all done
    return;
}


// stop the answer and swallow whatever goes wrong
auto
pyre::postgres::Stream::_close() noexcept -> void
{
    // a stream whose rows are all read
    if (!_live) {
        // needs nothing more
        return;
    }
    // a session that has been closed took the answer along
    if (!_connection._connection.valid()) {
        // so all that is left is to let go of it
        _end();
        // and that's all
        return;
    }
    // outside a transaction, the server may stop sending; inside one, stopping the statement
    // would fail the transaction, so the rows are read to the end instead
    if (!_transaction) {
        // ask the server to stop, which may fail when the request cannot reach it
        try {
            // ask
            _connection.cancel();
        }
        // in which case the rows are read to the end below, which takes longer and ends the
        // same; the channel is a warning and not an error on purpose: an error channel throws
        // when it flushes, and a throw from here, inside a {noexcept} destructor, ends the process
        catch (const Exception & error) {
            // make a channel
            auto channel = pyre::journal::warning_t("pyre.postgres.stream");
            // and complain
            channel
                // where
                << pyre::journal::here()
                // what
                << "could not ask the server to stop a stream whose rows are no longer wanted"
                << pyre::journal::newline
                // details
                << error.what()
                // flush
                << pyre::journal::endl;
        }
    }
    // collect the rest of the answer, which says how the statement ended, so that the session can
    // be used again
    const auto handle = _connection._connection.handle();
    // until there is no more of it
    while (PGresult * result = PQgetResult(handle)) {
        // throw each part away
        PQclear(result);
    }
    // and let go of the session
    _end();

    // all done
    return;
}


// end of file
