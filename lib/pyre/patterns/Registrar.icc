// code guard
#pragma once


// my declarations
#include "Registrar.h"


// destructor
template <typename objectT, typename nameT>
pyre::patterns::Registrar<objectT, nameT>::~Registrar()
{
    // delete the indexed items
    // assumes that all registered entities were dynamically allocated
    for (iterator_type i = this->begin(); i != this->end(); ++i) {
        delete i->second;
    }
}


// end of file
