// code guard
#pragma once


// my declarations
#include "Point.h"


// metamethods
template <class spaceT>
template <typename... argT>
    requires(
        not(sizeof...(argT) == 1
            and (std::is_same_v<std::remove_cvref_t<argT>, pyre::geometry::Point<spaceT>> and ...)))
constexpr pyre::geometry::Point<spaceT>::Point(argT &&... args) :
    _rep { std::forward<argT>(args)... }
{}

// interface
template <class spaceT>
constexpr auto
pyre::geometry::Point<spaceT>::dimension() -> size_type
{
    // ask my space
    return space_type::dimension();
}

template <class spaceT>
constexpr auto
pyre::geometry::Point<spaceT>::data() const -> const rep_type &
{
    // easy enough
    return _rep;
}

template <class spaceT>
constexpr auto
pyre::geometry::Point<spaceT>::operator[](size_type item) const
    requires requires(const rep_type & rep) { rep[0]; }
{
    // look up the coordinate
    return _rep[item];
}

template <class spaceT>
constexpr auto
pyre::geometry::Point<spaceT>::begin() const
    requires requires(const rep_type & rep) { rep.cbegin(); }
{
    // start at my first coordinate
    return _rep.cbegin();
}

template <class spaceT>
constexpr auto
pyre::geometry::Point<spaceT>::end() const
    requires requires(const rep_type & rep) { rep.cend(); }
{
    // and stop after my last one
    return _rep.cend();
}

// global operators
template <class spaceT>
auto
pyre::geometry::operator<<(std::ostream & stream, const Point<spaceT> & point) -> std::ostream &
{
    // the space knows how its points are written
    spaceT::inject(stream, point.data());
    // all done
    return stream;
}


// end of file
