// code guard
#pragma once


// my declarations
#include "relations.h"


// the pairs that know how
template <pyre::geometry::line_c lineT>
constexpr auto
pyre::geometry::relations::intersects(const Interval<lineT> & a, const Interval<lineT> & b) -> bool
{
    // an empty interval shares nothing
    if (a.empty() or b.empty()) {
        return false;
    }
    // otherwise, two intervals share a point when each starts before the other ends; their ends
    // belong to them, so touching ends are a shared point
    return lineT::coordinate(a.lower().data()) <= lineT::coordinate(b.upper().data())
       and lineT::coordinate(b.lower().data()) <= lineT::coordinate(a.upper().data());
}

template <class shapeT, class otherT>
constexpr auto
pyre::geometry::relations::intersects(const Collection<shapeT> & a, const otherT & b) -> bool
{
    // a union shares a point with {b} when one of its members does
    return std::any_of(a.begin(), a.end(), [&b](const shapeT & member) {
        // whichever of the two knows how
        return pyre::geometry::intersects(member, b);
    });
}


// the shapes on the sphere
template <class chartT>
auto
pyre::geometry::relations::intersects(
    const Box<chartT> & a, const Point<typename chartT::space_type> & b) -> bool
{
    // the box knows
    return a.contains(b);
}

template <class chartT>
auto
pyre::geometry::relations::intersects(const Box<chartT> & a, const Box<chartT> & b) -> bool
{
    // an empty box shares nothing
    if (a.empty() || b.empty()) {
        return false;
    }
    // the parallels of the two must overlap, within the slack of the boxes
    if (a.north() + a.slack < b.south() || b.north() + b.slack < a.south()) {
        // or they don't meet
        return false;
    }
    // and so must the meridians: two ranges of longitude overlap when one of them holds the
    // west edge of the other
    return a.spans(b.west()) || b.spans(a.west());
}

template <class chartT>
auto
pyre::geometry::relations::intersects(
    const Path<chartT> & a, const Point<typename chartT::space_type> & b) -> bool
{
    // the path knows
    return a.contains(b);
}

template <class chartT>
auto
pyre::geometry::relations::intersects(const Path<chartT> & a, const Path<chartT> & b) -> bool
{
    // paths whose envelopes don't meet
    if (!relations::intersects(a.envelope(), b.envelope())) {
        // don't either
        return false;
    }
    // otherwise, they meet when their arcs do
    return spherical::meets(a.arcs(), b.arcs());
}

template <class chartT>
auto
pyre::geometry::relations::intersects(const Path<chartT> & a, const Box<chartT> & b) -> bool
{
    // an empty box
    if (b.empty()) {
        // shares nothing
        return false;
    }
    // otherwise, the edges of the box along the parallels are not great circles, so it meets the
    // path the way the polygon with its points does
    return relations::intersects(b.polygon(), a);
}

template <class chartT>
auto
pyre::geometry::relations::intersects(
    const Polygon<chartT> & a, const Point<typename chartT::space_type> & b) -> bool
{
    // the polygon knows
    return a.contains(b);
}

template <class chartT>
auto
pyre::geometry::relations::intersects(const Polygon<chartT> & a, const Path<chartT> & b) -> bool
{
    // a polygon and a path whose envelopes don't meet
    if (!relations::intersects(a.envelope(), b.envelope())) {
        // don't either
        return false;
    }
    // a path that meets the boundary of the polygon
    for (const auto & ring : a.rings()) {
        // meets one of its rings
        if (spherical::meets(ring.arcs(), b.arcs())) {
            // so it passes through the polygon
            return true;
        }
    }
    // otherwise, the path is either all inside the polygon or all outside it, and any of its
    // points tells which
    return !b.arcs().empty() && a.contains(Point<typename chartT::space_type>(b.arcs().front()));
}

template <class chartT>
auto
pyre::geometry::relations::intersects(const Polygon<chartT> & a, const Box<chartT> & b) -> bool
{
    // an empty box
    if (b.empty()) {
        // shares nothing
        return false;
    }
    // otherwise, the edges of the box along the parallels are not great circles, so it meets the
    // polygon the way the polygon with its points does
    return relations::intersects(a, b.polygon());
}

template <class chartT>
auto
pyre::geometry::relations::intersects(const Polygon<chartT> & a, const Polygon<chartT> & b) -> bool
{
    // the points of the space
    using point_t = Point<typename chartT::space_type>;
    // a polygon without rings is the whole sphere, which meets every other polygon
    if (a.rings().empty() || b.rings().empty()) {
        return true;
    }
    // polygons whose envelopes don't meet
    if (!relations::intersects(a.envelope(), b.envelope())) {
        // don't either
        return false;
    }
    // polygons whose boundaries meet
    for (const auto & first : a.rings()) {
        // through any ring of each
        for (const auto & second : b.rings()) {
            // share the points where they do
            if (spherical::meets(first.arcs(), second.arcs())) {
                return true;
            }
        }
    }
    // otherwise, each polygon is either all inside the other or all outside it, and a point on
    // its boundary tells which
    return b.contains(point_t(a.rings().front().arcs().front()))
        || a.contains(point_t(b.rings().front().arcs().front()));
}


// the relations
template <class firstT, class secondT>
    requires(
        requires(const firstT & a, const secondT & b) {
            pyre::geometry::relations::intersects(a, b);
        }
        or requires(
            const firstT & a, const secondT & b) { pyre::geometry::relations::intersects(b, a); })
constexpr auto
pyre::geometry::intersects(const firstT & a, const secondT & b) -> bool
{
    // if the pair knows how in this order
    if constexpr (requires { relations::intersects(a, b); }) {
        // ask it
        return relations::intersects(a, b);
    }
    // otherwise, it knows how in the other one
    else {
        // so ask it that way
        return relations::intersects(b, a);
    }
}

template <pyre::geometry::line_c lineT>
constexpr auto
pyre::geometry::covers(const Interval<lineT> & a, const Interval<lineT> & b) -> bool
{
    // every interval covers the empty one
    if (b.empty()) {
        return true;
    }
    // the empty interval covers no other
    if (a.empty()) {
        return false;
    }
    // otherwise, {a} covers {b} when {b} starts no earlier and ends no later
    return lineT::coordinate(a.lower().data()) <= lineT::coordinate(b.lower().data())
       and lineT::coordinate(b.upper().data()) <= lineT::coordinate(a.upper().data());
}

template <pyre::geometry::line_c lineT>
constexpr auto
pyre::geometry::covers(const Collection<Interval<lineT>> & a, const Interval<lineT> & b) -> bool
{
    // every union covers the empty interval
    if (b.empty()) {
        return true;
    }
    // the members that share a point with {b} are the ones that may cover it
    auto pieces = std::vector<Interval<lineT>> {};
    // so collect them
    std::copy_if(
        a.begin(), a.end(), std::back_inserter(pieces),
        [&b](const Interval<lineT> & member) { return intersects(member, b); });
    // and put them in the order of their lower ends
    std::sort(
        pieces.begin(), pieces.end(), [](const Interval<lineT> & p, const Interval<lineT> & q) {
            return lineT::coordinate(p.lower().data()) < lineT::coordinate(q.lower().data());
        });
    // the pieces cover {b} up to its lower end before any of them is placed
    auto reach = lineT::coordinate(b.lower().data());
    // where they must reach to cover it
    auto goal = lineT::coordinate(b.upper().data());
    // go through the pieces in order
    for (const auto & piece : pieces) {
        // a piece that starts beyond the reach leaves a gap
        if (lineT::coordinate(piece.lower().data()) > reach) {
            // so {b} is not covered
            return false;
        }
        // otherwise, the piece extends the reach to its upper end, if that is further
        reach = std::max(reach, lineT::coordinate(piece.upper().data()));
        // once the reach gets to the upper end of {b}
        if (reach >= goal) {
            // {b} is covered
            return true;
        }
    }
    // if the pieces run out first, {b} is not covered
    return false;
}

template <class shapeT, class memberT>
    requires pyre::geometry::covers_c<shapeT, memberT>
constexpr auto
pyre::geometry::covers(const shapeT & a, const Collection<memberT> & b) -> bool
{
    // {a} covers the union when it covers every member
    return std::all_of(
        b.begin(), b.end(), [&a](const memberT & member) { return covers(a, member); });
}


template <class chartT>
auto
pyre::geometry::covers(const Box<chartT> & a, const Point<typename chartT::space_type> & b) -> bool
{
    // a box covers a point when it holds it
    return a.contains(b);
}

template <class chartT>
auto
pyre::geometry::covers(const Polygon<chartT> & a, const Point<typename chartT::space_type> & b)
    -> bool
{
    // a polygon covers a point when it holds it
    return a.contains(b);
}


