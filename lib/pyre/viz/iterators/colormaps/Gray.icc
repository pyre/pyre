// code guard
#if !defined(pyre_viz_colormaps_Gray_icc)
#error this file contains implementation details for pyre::viz::iterators::colormaps::Gray
#else

// metamethods
template <class sourceT>
pyre::viz::iterators::colormaps::Gray<sourceT>::Gray(source_const_reference source) :
    _source { source }
{}


// interface
template <class sourceT>
auto
pyre::viz::iterators::colormaps::Gray<sourceT>::operator*() const -> rgb_type
{
    // get the value from the data source and clip it to the unit interval as a color channel
    viz::color_t value = std::min(1.0, std::max(0.0, double(*_source)));

    // produce a gray by using that value for all three channels
    return rgb_type { value, value, value };
}


template <class sourceT>
auto
pyre::viz::iterators::colormaps::Gray<sourceT>::operator++() -> void
{
    // make {_source} point to the next value
    ++_source;
    // all done
    return;
}


#endif

// end of file
