// code guard
#pragma once


// my declarations
#include "RGB.h"

// metamethods
template <class redSourceT, class greenSourceT, class blueSourceT>
pyre::viz::iterators::colormaps::RGB<redSourceT, greenSourceT, blueSourceT>::RGB(
    red_source_const_reference red, green_source_const_reference green,
    blue_source_const_reference blue) :
    _red { red },
    _green { green },
    _blue { blue }
{}


// interface
template <class redSourceT, class greenSourceT, class blueSourceT>
auto
pyre::viz::iterators::colormaps::RGB<redSourceT, greenSourceT, blueSourceT>::operator*() const
    -> rgb_type
{
    // pull the current value from each channel source and clip it to the unit interval as a
    // color channel, since there are no colors of my own for values outside it
    viz::color_t red = std::min(1.0, std::max(0.0, double(*_red)));
    viz::color_t green = std::min(1.0, std::max(0.0, double(*_green)));
    viz::color_t blue = std::min(1.0, std::max(0.0, double(*_blue)));

    // assemble the color from the three channels
    return rgb_type { red, green, blue };
}


template <class redSourceT, class greenSourceT, class blueSourceT>
auto
pyre::viz::iterators::colormaps::RGB<redSourceT, greenSourceT, blueSourceT>::operator++() -> void
{
    // make my sources point to their next value
    ++_red;
    ++_green;
    ++_blue;
    // all done
    return;
}


// end of file
