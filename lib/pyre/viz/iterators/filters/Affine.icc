// code guard
#pragma once


// my declarations
#include "Affine.h"


// metamethods
// constructor
template <class sourceT>
pyre::viz::iterators::filters::Affine<sourceT>::Affine(
    source_const_reference source, interval_type interval) :
    _source(source),
    _interval(interval)
{}


// interface
template <class sourceT>
auto
pyre::viz::iterators::filters::Affine<sourceT>::operator*() const -> value_type
{
    // get the value from my {_source}
    auto value = *_source;
    // unpack my interval
    auto [low, high] = _interval;
    // clip {value} to the unit interval
    value = std::max(0.0, std::min(1.0, value));
    // affine it
    auto p = low + value * (high - low);
    // and return it
    return p;
}


template <class sourceT>
auto
pyre::viz::iterators::filters::Affine<sourceT>::operator++() -> void
{
    // increment my source
    ++_source;
    // all done
    return;
}


// end of file
