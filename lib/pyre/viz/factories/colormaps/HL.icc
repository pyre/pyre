// mutators
template <class hueT, class luminosityT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::hue(hue_ref_type hue)
    -> factory_ref_type
{
    // connect my {hue} slot
    addInput("hue", std::static_pointer_cast<pyre::flow::product_t>(hue));
    // make a self reference
    auto self = std::dynamic_pointer_cast<HL>(ref());
    // and return it
    return self;
}

