// code guard
#pragma once


// my declarations
#include "HL.h"


// simulate my c++ declaration
template <class hueT, class luminosityT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::declSelf()
    -> string_type
{
    // the type alias, with the declarations of my slots
    return "pyre::viz::factories::colormaps::hl_t<" + hue_type::declSelf() + ", "
         + luminosity_type::declSelf() + ", " + red_type::declSelf() + ", " + green_type::declSelf()
         + ", " + blue_type::declSelf() + ">";
}


// the human readable form of my class name
template <class hueT, class luminosityT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::className()
    -> string_type
{
    // my kind
    return "HL";
}


// the descriptions of my slots
template <class hueT, class luminosityT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::declSlots()
    -> const slots_type &
{
    // my slots, in the order i declare them
    static const slots_type table {
        slot_type::input<hue_type>("hue"),    slot_type::input<luminosity_type>("luminosity"),
        slot_type::output<red_type>("red"),   slot_type::output<green_type>("green"),
        slot_type::output<blue_type>("blue"),
    };
    // hand them off
    return table;
}


// the descriptions of my settings
template <class hueT, class luminosityT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::declSettings()
    -> const settings_type &
{
    // my settings
    static const settings_type table {
        setting_type::of<self_type>("threshold", &self_type::threshold, &self_type::threshold),
    };
    // hand them off
    return table;
}


// the descriptions of my slots
template <class hueT, class luminosityT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::slots() const
    -> const slots_type &
{
    // the ones of my type
    return declSlots();
}


// the descriptions of my settings
template <class hueT, class luminosityT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::settings() const
    -> const settings_type &
{
    // the ones of my type
    return declSettings();
}


// factory
template <class hueT, class luminosityT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::create(
    const name_type & name, double threshold) -> factory_ref_type
{
    // build an instance and wrap it in a shared pointer
    auto ref = std::make_shared<HL>(sentinel_type(), name, threshold);
    // make a channel
    auto channel = pyre::journal::debug_t("pyre.viz.factories.colormaps.hl.create");
    // show me
    channel
        // where
        << pyre::journal::at()
        // the factory
        << "hl '" << ref->name() << "' at " << ref.get() << ": create"
        << pyre::journal::newline
        // flush
        << pyre::journal::endl;
    // return it
    return ref;
}

// constructor
template <class hueT, class luminosityT, class redT, class greenT, class blueT>
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::HL(
    sentinel_type sentinel, const name_type & name, double threshold) :
    // superclass
    super_type(sentinel, name),
    // members
    _threshold(threshold)
{}

// destructor
template <class hueT, class luminosityT, class redT, class greenT, class blueT>
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::~HL()
{}

// accessors
template <class hueT, class luminosityT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::threshold() const
    -> double
{
    // easy enough
    return _threshold;
}

template <class hueT, class luminosityT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::threshold(
    double threshold) -> factory_ref_type
{
    // update the threshold
    _threshold = threshold;
    // invalidate the downstream graph
    flush();
    // make a self reference
    auto self = std::dynamic_pointer_cast<HL>(ref());
    // and return it
    return self;
}

template <class hueT, class luminosityT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::hue() -> hue_ref_type
{
    // look up the product bound to my {hue} slot and return it
    return std::dynamic_pointer_cast<hue_type>(input("hue"));
}

template <class hueT, class luminosityT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::luminosity()
    -> luminosity_ref_type
{
    // look up the product bound to my {luminosity} slot and return it
    return std::dynamic_pointer_cast<luminosity_type>(input("luminosity"));
}

template <class hueT, class luminosityT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::HL<hueT, luminosityT, redT, greenT, blueT>::red() -> red_ref_type
{
    // look up the product bound to my {red} slot and return it
    return std::dynamic_pointer_cast<red_type>(output("red"));
}

