// mutators
template <class lightnessT, class chromaT, class hueT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::OKLCH<lightnessT, chromaT, hueT, redT, greenT, blueT>::lightness(
    lightness_ref_type lightness) -> factory_ref_type
{
    // connect my {lightness} slot
    addInput("lightness", std::static_pointer_cast<pyre::flow::product_t>(lightness));
    // make a self reference
    auto self = std::dynamic_pointer_cast<OKLCH>(ref());
    // and return it
    return self;
}

