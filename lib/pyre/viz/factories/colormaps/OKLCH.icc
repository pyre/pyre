// code guard
#pragma once


// my declarations
#include "OKLCH.h"


// factory
template <class lightnessT, class chromaT, class hueT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::OKLCH<lightnessT, chromaT, hueT, redT, greenT, blueT>::create(
    const name_type & name) -> factory_ref_type
{
    // build an instance and wrap it in a shared pointer
    auto ref = std::make_shared<OKLCH>(sentinel_type(), name);
    // make a channel
    auto channel = pyre::journal::debug_t("pyre.viz.factories.colormaps.oklch.create");
    // show me
    channel
        // where
        << pyre::journal::at()
        // the factory
        << "oklch '" << ref->name() << "' at " << ref.get() << ": create"
        << pyre::journal::newline
        // flush
        << pyre::journal::endl;
    // return it
    return ref;
}

// constructor
template <class lightnessT, class chromaT, class hueT, class redT, class greenT, class blueT>
pyre::viz::factories::colormaps::OKLCH<lightnessT, chromaT, hueT, redT, greenT, blueT>::OKLCH(
    sentinel_type sentinel, const name_type & name) :
    // superclass
    super_type(sentinel, name)
{}

// destructor
template <class lightnessT, class chromaT, class hueT, class redT, class greenT, class blueT>
pyre::viz::factories::colormaps::OKLCH<lightnessT, chromaT, hueT, redT, greenT, blueT>::~OKLCH()
{}

// accessors
template <class lightnessT, class chromaT, class hueT, class redT, class greenT, class blueT>
auto
pyre::viz::factories::colormaps::OKLCH<lightnessT, chromaT, hueT, redT, greenT, blueT>::lightness()
    -> lightness_ref_type
{
    // look up the product bound to my {lightness} slot and return it
    return std::dynamic_pointer_cast<lightness_type>(input("lightness"));
}

