// code guard
#pragma once


// my declarations
#include "operators.h"


// binary operators
template <typename numeric_t>
numeric_t
pyre::algebra::operator+(const numeric_t & a, const numeric_t & b)
{
    numeric_t result(a);
    result += b;
    return result;
}


template <typename numeric_t>
numeric_t
pyre::algebra::operator-(const numeric_t & a, const numeric_t & b)
{
    numeric_t result(a);
    result -= b;
    return result;
}


template <typename numeric_t>
numeric_t
pyre::algebra::operator*(const numeric_t & a, const numeric_t & b)
{
    numeric_t result(a);
    result *= b;
    return result;
}


template <typename numeric_t>
numeric_t
pyre::algebra::operator/(const numeric_t & a, const numeric_t & b)
{
    numeric_t result(a);
    result /= b;
    return result;
}


// end of file
