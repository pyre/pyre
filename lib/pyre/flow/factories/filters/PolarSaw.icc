// code guard
#pragma once


// my declarations
#include "PolarSaw.h"


// simulate my c++ declaration
template <class signalT, class polarsawT>
auto
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::declSelf() -> string_type
{
    // the type alias, with the declarations of my slots
    return "pyre::flow::factories::filters::polarsaw_t<" + signal_type::declSelf() + ", "
         + polarsaw_type::declSelf() + ">";
}


// the human readable form of my class name
template <class signalT, class polarsawT>
auto
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::className() -> string_type
{
    // my kind
    return "PolarSaw";
}


// the descriptions of my slots
template <class signalT, class polarsawT>
auto
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::declSlots() -> const slots_type &
{
    // my slots, in the order i declare them
    static const slots_type table {
        slot_type::input<signal_type>("signal"),
        slot_type::output<polarsaw_type>("polarsaw"),
    };
    // hand them off
    return table;
}


// the descriptions of my settings
template <class signalT, class polarsawT>
auto
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::declSettings()
    -> const settings_type &
{
    // i have none that can be changed by name
    static const settings_type table {};
    // hand them off
    return table;
}


// the descriptions of my slots
template <class signalT, class polarsawT>
auto
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::slots() const -> const slots_type &
{
    // the ones of my type
    return declSlots();
}


// the descriptions of my settings
template <class signalT, class polarsawT>
auto
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::settings() const
    -> const settings_type &
{
    // the ones of my type
    return declSettings();
}


// factory
template <class signalT, class polarsawT>
auto
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::create(const name_type & name)
    -> factory_ref_type
{
    // make an instance and wrap it in a shared pointer
    auto ref = std::make_shared<PolarSaw>(sentinel_type(), name);
    // make a channel
    auto channel = pyre::journal::debug_t("pyre.flow.factories.filters.polarsaw");
    // let me know
    channel
        // where
        << pyre::journal::at()
        // mark
        << "polarsaw '" << ref->name() << "' at " << ref.get() << ": create"
        << pyre::journal::newline
        // flush
        << pyre::journal::endl;

    // all done
    return ref;
}

// destructor
template <class signalT, class polarsawT>
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::~PolarSaw()
{
    // make a channel
    auto channel = pyre::journal::debug_t("pyre.flow.factories.filters.polarsaw");
    // let me know
    channel
        // where
        << pyre::journal::at()
        // mark
        << "polarsaw '" << name() << "' at " << this << ": destroy"
        << pyre::journal::newline
        // flush
        << pyre::journal::endl;

    // all done
    return;
}

// constructor
template <class signalT, class polarsawT>
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::PolarSaw(
    sentinel_type sentinel, const name_type & name) :
    // superclass
    super_type(sentinel, name)
{}

// accessors
template <class signalT, class polarsawT>
auto
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::signal() -> signal_ref_type
{
    // look up the product bound to my {signal} slot and return it
    return std::dynamic_pointer_cast<signal_type>(input("signal"));
}

template <class signalT, class polarsawT>
auto
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::polarsaw() -> polarsaw_ref_type
{
    // look up the product bound to my {signal} slot and return it
    return std::dynamic_pointer_cast<polarsaw_type>(output("polarsaw"));
}

// mutators
template <class signalT, class polarsawT>
auto
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::signal(signal_ref_type signal)
    -> factory_ref_type
{
    // bind {signal} to my slot
    addInput("signal", std::static_pointer_cast<pyre::flow::protocols::Product>(signal));
    // make a self reference
    auto self = std::dynamic_pointer_cast<PolarSaw>(ref());
    // and return it
    return self;
}

template <class signalT, class polarsawT>
auto
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::polarsaw(polarsaw_ref_type polarsaw)
    -> factory_ref_type
{
    // bind {polarsaw} to my slot
    addOutput("polarsaw", std::static_pointer_cast<pyre::flow::protocols::Product>(polarsaw));
    // make a self reference
    auto self = std::dynamic_pointer_cast<PolarSaw>(ref());
    // and return it
    return self;
}

// interface
template <class signalT, class polarsawT>
auto
pyre::flow::factories::filters::PolarSaw<signalT, polarsawT>::make(
    const name_type & slot, super_type::product_ref_type product) -> super_type::factory_ref_type
{
    // chain up
    auto self = super_type::make(slot, product);
    // get read access to the signal
    auto & signal = this->signal()->read();
    // get write access to the polarsaw data
    auto & polarsaw = this->polarsaw()->write();
    // get the number cells in the output tile
    auto cells = polarsaw.packing().cells();
    // make sure the input is compatible
    bool ok = cells == signal.packing().cells();
    // if not
    if (!ok) {
        // make a channel
        auto channel = pyre::journal::error_t("pyre.flow.factories.filters.polarsaw");
        // complain
        channel
            // where
            << pyre::journal::at()
            // who
            << "polarsaw '" << this->name() << "' at " << this << ":"
            << pyre::journal::newline
            // what
            << "shape mismatch in the input and output slots"
            << pyre::journal::newline
            // inputs
            << "inputs "
            << pyre::journal::newline
            // indent
            << pyre::journal::indent
            // signal
            << "signal: " << signal.packing().cells()
            << pyre::journal::newline
            // outdent
            << pyre::journal::outdent
            // outputs
            << "outputs: "
            << pyre::journal::newline
            // indent
            << pyre::journal::indent
            // polarsaw
            << "polarsaw: " << polarsaw.packing().cells()
            << pyre::journal::newline
            // outdent
            << pyre::journal::outdent
            // flush
            << pyre::journal::endl;
        // and bail, just in case errors aren't fatal
        return self;
    }

    // go over the cells
    for (decltype(cells) cell = 0; cell < cells; ++cell) {
        // read the value from the signal and get its magnitude
        auto saw = signal[cell] * 6 / M_PI;
        // project it into [0,1]
        auto value = std::abs(saw - std::trunc(saw));
        // and store
        polarsaw[cell] = value;
    }
    // all done
    return self;
}


