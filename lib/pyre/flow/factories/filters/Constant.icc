// code guard
#pragma once


// my declarations
#include "Constant.h"


// simulate my c++ declaration
template <class constantT>
auto
pyre::flow::factories::filters::Constant<constantT>::declSelf() -> string_type
{
    // the type alias, with the declarations of my slots
    return "pyre::flow::factories::filters::constant_t<" + product_type::declSelf() + ">";
}


// the human readable form of my class name
template <class constantT>
auto
pyre::flow::factories::filters::Constant<constantT>::className() -> string_type
{
    // my kind
    return "Constant";
}


// the descriptions of my slots
template <class constantT>
auto
pyre::flow::factories::filters::Constant<constantT>::declSlots() -> const slots_type &
{
    // my slots, in the order i declare them
    static const slots_type table {
        slot_type::output<product_type>("tile"),
    };
    // hand them off
    return table;
}


// the descriptions of my settings
template <class constantT>
auto
pyre::flow::factories::filters::Constant<constantT>::declSettings() -> const settings_type &
{
    // a constant of cells a setting can hold has its value as a setting
    if constexpr (setting_type::represents<cell_type>()) {
        // so describe it
        static const settings_type table {
            setting_type::of<self_type>("value", &self_type::value, &self_type::value),
        };
        // hand it off
        return table;
    }
    // any other has none
    else {
        // so describe nothing
        static const settings_type table {};
        // hand it off
        return table;
    }
}


// the descriptions of my slots
template <class constantT>
auto
pyre::flow::factories::filters::Constant<constantT>::slots() const -> const slots_type &
{
    // the ones of my type
    return declSlots();
}


// the descriptions of my settings
template <class constantT>
auto
pyre::flow::factories::filters::Constant<constantT>::settings() const -> const settings_type &
{
    // the ones of my type
    return declSettings();
}


// factory
template <class constantT>
auto
pyre::flow::factories::filters::Constant<constantT>::create(const name_type & name, cell_type value)
    -> factory_ref_type
{
    // make an instance and wrap it in a shared pointer
    auto ref = std::make_shared<Constant>(sentinel_type(), name, value);
    // make a channel
    auto channel = pyre::journal::debug_t("pyre.flow.factories.filters.constant");
    // let me know
    channel
        // where
        << pyre::journal::at()
        // mark
        << "constant '" << ref->name() << "' at " << ref.get() << ": create"
        << pyre::journal::newline
        // flush
        << pyre::journal::endl;

    // all done
    return ref;
}

// destructor
template <class constantT>
pyre::flow::factories::filters::Constant<constantT>::~Constant()
{
    // make a channel
    auto channel = pyre::journal::debug_t("pyre.flow.factories.filters.constant");
    // let me know
    channel
        // where
        << pyre::journal::at()
        // mark
        << "constant '" << name() << "' at " << this << ": destroy"
        << pyre::journal::newline
        // flush
        << pyre::journal::endl;

    // all done
    return;
}

// constructor
template <class constantT>
pyre::flow::factories::filters::Constant<constantT>::Constant(
    sentinel_type sentinel, const name_type & name, cell_type value) :
    // superclass
    super_type(sentinel, name),
    // members
    _value(value)
{}

// accessors
template <class constantT>
auto
pyre::flow::factories::filters::Constant<constantT>::value() const -> cell_type
{
    // easy enough
    return _value;
}

template <class constantT>
auto
pyre::flow::factories::filters::Constant<constantT>::tile() -> product_ref_type
{
    // look up the product bound to my {tile} slot and return it
    return std::dynamic_pointer_cast<product_type>(output("tile"));
}

// mutators
template <class constantT>
auto
pyre::flow::factories::filters::Constant<constantT>::value(cell_type value) -> factory_ref_type
{
    // update the value
    _value = value;
    // invalidate the downstream graph
    flush();
    // make a self reference
    auto self = std::dynamic_pointer_cast<Constant>(ref());
    // and return it
    return self;
}

template <class constantT>
auto
pyre::flow::factories::filters::Constant<constantT>::tile(product_ref_type tile) -> factory_ref_type
{
    // bind {tile} to my slot
    addOutput("tile", std::static_pointer_cast<pyre::flow::protocols::Product>(tile));
    // make a self reference
    auto self = std::dynamic_pointer_cast<Constant>(ref());
    // and return it
    return self;
}


// interface
template <class constantT>
auto
pyre::flow::factories::filters::Constant<constantT>::make(
    const name_type & slot, super_type::product_ref_type product) -> super_type::factory_ref_type
{
    // chain up
    auto self = super_type::make(slot, product);
    // get write access to the tile data
    auto & data = tile()->write();
    // fill it with my value
    std::fill(data.begin(), data.end(), _value);
    // all done
    return self;
}


// end of file
