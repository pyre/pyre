// code guard
#pragma once


// my declarations
#include "Affine.h"


// simulate my c++ declaration
template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::declSelf() -> string_type
{
    // the type alias, with the declarations of my slots
    return "pyre::flow::factories::filters::affine_t<" + signal_type::declSelf() + ", "
         + affine_type::declSelf() + ">";
}


// the human readable form of my class name
template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::className() -> string_type
{
    // my kind
    return "Affine";
}


// the descriptions of my slots
template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::declSlots() -> const slots_type &
{
    // my slots, in the order i declare them
    static const slots_type table {
        slot_type::input<signal_type>("signal"),
        slot_type::output<affine_type>("affine"),
    };
    // hand them off
    return table;
}


// the descriptions of my settings
template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::declSettings() -> const settings_type &
{
    // my settings
    static const settings_type table {
        setting_type::of<self_type>("interval", &self_type::interval, &self_type::interval),
    };
    // hand them off
    return table;
}


// the descriptions of my slots
template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::slots() const -> const slots_type &
{
    // the ones of my type
    return declSlots();
}


// the descriptions of my settings
template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::settings() const -> const settings_type &
{
    // the ones of my type
    return declSettings();
}


// factory
template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::create(
    const name_type & name, interval_type interval) -> factory_ref_type
{
    // make an instance and wrap it in a shared pointer
    auto ref = std::make_shared<Affine>(sentinel_type(), name, interval);
    // make a channel
    auto channel = pyre::journal::debug_t("pyre.flow.factories.filters.affine");
    // let me know
    channel
        // where
        << pyre::journal::at()
        // mark
        << "affine '" << ref->name() << "' at " << ref.get() << ": create"
        << pyre::journal::newline
        // flush
        << pyre::journal::endl;

    // all done
    return ref;
}

// destructor
template <class signalT, class affineT>
pyre::flow::factories::filters::Affine<signalT, affineT>::~Affine()
{
    // make a channel
    auto channel = pyre::journal::debug_t("pyre.flow.factories.filters.affine");
    // let me know
    channel
        // where
        << pyre::journal::at()
        // mark
        << "affine '" << name() << "' at " << this << ": destroy"
        << pyre::journal::newline
        // flush
        << pyre::journal::endl;

    // all done
    return;
}

// constructor
template <class signalT, class affineT>
pyre::flow::factories::filters::Affine<signalT, affineT>::Affine(
    sentinel_type sentinel, const name_type & name, interval_type interval) :
    // superclass
    super_type(sentinel, name),
    // members
    _interval(interval)
{}

// accessors
template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::interval() const -> interval_type
{
    // easy enough
    return _interval;
}

template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::signal() -> signal_ref_type
{
    // look up the product bound to my {signal} slot and return it
    return std::dynamic_pointer_cast<signal_type>(input("signal"));
}

template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::affine() -> affine_ref_type
{
    // look up the product bound to my {signal} slot and return it
    return std::dynamic_pointer_cast<affine_type>(output("affine"));
}

// mutators
template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::interval(interval_type interval)
    -> factory_ref_type
{
    // update the interval
    _interval = interval;
    // invalidate the downstream graph
    flush();
    // make a self reference
    auto self = std::dynamic_pointer_cast<Affine>(ref());
    // and return it
    return self;
}

template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::signal(signal_ref_type signal)
    -> factory_ref_type
{
    // bind {signal} to my slot
    addInput("signal", std::static_pointer_cast<pyre::flow::protocols::Product>(signal));
    // make a self reference
    auto self = std::dynamic_pointer_cast<Affine>(ref());
    // and return it
    return self;
}

template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::affine(affine_ref_type affine)
    -> factory_ref_type
{
    // bind {affine} to my slot
    addOutput("affine", std::static_pointer_cast<pyre::flow::protocols::Product>(affine));
    // make a self reference
    auto self = std::dynamic_pointer_cast<Affine>(ref());
    // and return it
    return self;
}

// interface
template <class signalT, class affineT>
auto
pyre::flow::factories::filters::Affine<signalT, affineT>::make(
    const name_type & slot, super_type::product_ref_type product) -> super_type::factory_ref_type
{
    // chain up
    auto self = super_type::make(slot, product);
    // get read access to the signal
    auto & signal = this->signal()->read();
    // get write access to the affine data
    auto & affine = this->affine()->write();
    // get the number cells in the output tile
    auto cells = affine.packing().cells();
    // make sure the input is compatible
    bool ok = cells == signal.packing().cells();
    // if not
    if (!ok) {
        // make a channel
        auto channel = pyre::journal::error_t("pyre.flow.factories.filters.affine");
        // complain
        channel
            // where
            << pyre::journal::at()
            // who
            << "affine '" << this->name() << "' at " << this << ":"
            << pyre::journal::newline
            // what
            << "shape mismatch in the input and output slots"
            << pyre::journal::newline
            // inputs
            << "inputs "
            << pyre::journal::newline
            // indent
            << pyre::journal::indent
            // signal
            << "signal: " << signal.packing().cells()
            << pyre::journal::newline
            // outdent
            << pyre::journal::outdent
            // outputs
            << "outputs: "
            << pyre::journal::newline
            // indent
            << pyre::journal::indent
            // affine
            << "affine: " << affine.packing().cells()
            << pyre::journal::newline
            // outdent
            << pyre::journal::outdent
            // flush
            << pyre::journal::endl;
        // and bail, just in case errors aren't fatal
        return self;
    }

    // unpack my interval
    auto [low, high] = _interval;
    // compute its length
    auto delta = high - low;
    // go over the cells
    for (decltype(cells) cell = 0; cell < cells; ++cell) {
        // read the value from the signal
        double value = signal[cell];
        // clip it
        value = std::max(0.0, std::min(1.0, value));
        // map it
        auto p = low + value * delta;
        // and store it
        affine[cell] = p;
    }
    // all done
    return self;
}


