// code guard
#pragma once


// my declarations
#include "Arithmetic.h"


// simulate my c++ declaration
template <class operationT, class op1T, class op2T, class resultT>
    requires pyre::flow::factories::operators::arithmetic_c<operationT, op1T, op2T, resultT>
auto
pyre::flow::factories::operators::Arithmetic<operationT, op1T, op2T, resultT>::declSelf()
    -> string_type
{
    // the alias of my operation, with the declarations of my slots
    return "pyre::flow::factories::operators::" + traits_type::decl() + "<" + op1_type::declSelf()
         + ", " + op2_type::declSelf() + ", " + result_type::declSelf() + ">";
}


// the human readable form of my class name
template <class operationT, class op1T, class op2T, class resultT>
    requires pyre::flow::factories::operators::arithmetic_c<operationT, op1T, op2T, resultT>
auto
pyre::flow::factories::operators::Arithmetic<operationT, op1T, op2T, resultT>::className()
    -> string_type
{
    // my kind
    return traits_type::className();
}


// factory
template <class operationT, class op1T, class op2T, class resultT>
    requires pyre::flow::factories::operators::arithmetic_c<operationT, op1T, op2T, resultT>
auto
pyre::flow::factories::operators::Arithmetic<operationT, op1T, op2T, resultT>::create(
    const name_type & name) -> factory_ref_type
{
    // build an instance and wrap it in a shared pointer
    auto ref = std::make_shared<Arithmetic>(sentinel_type(), name);
    // make a channel
    auto channel =
        pyre::journal::debug_t("pyre.flow.factories.operators." + traits_type::name() + ".create");
    // show me
    channel
        // where
        << pyre::journal::at()
        // the factory
        << traits_type::name() << " '" << ref->name() << "' at " << ref.get() << ": create"
        << pyre::journal::newline
        // flush
        << pyre::journal::endl;
    // return it
    return ref;
}


// destructor
template <class operationT, class op1T, class op2T, class resultT>
    requires pyre::flow::factories::operators::arithmetic_c<operationT, op1T, op2T, resultT>
pyre::flow::factories::operators::Arithmetic<operationT, op1T, op2T, resultT>::~Arithmetic()
{}


// constructor
template <class operationT, class op1T, class op2T, class resultT>
    requires pyre::flow::factories::operators::arithmetic_c<operationT, op1T, op2T, resultT>
pyre::flow::factories::operators::Arithmetic<operationT, op1T, op2T, resultT>::Arithmetic(
    sentinel_type sentinel, const name_type & name) :
    // superclass
    super_type(sentinel, name)
{}


// flow protocol
template <class operationT, class op1T, class op2T, class resultT>
    requires pyre::flow::factories::operators::arithmetic_c<operationT, op1T, op2T, resultT>
auto
pyre::flow::factories::operators::Arithmetic<operationT, op1T, op2T, resultT>::make(
    const name_type & slot, product_ref_type product) -> typename super_type::factory_ref_type
{
    // chain up
    auto self = super_type::make(slot, product);
    // the operation
    auto operation = operation_type {};

    // two scalars
    if constexpr (scalar_c<result_type>) {
        // combine the values of the operands
        auto value = operation(this->op1()->read(), this->op2()->read());
        // and record the outcome
        this->result()->write(value);
        // all done
        return self;
    }
    // otherwise, the result is a tile, and so are some of the operands
    else {
        // the tiles must cover the same grid
        if (!aligned()) {
            // and when they do not, there is nothing to make, in case errors are not fatal
            return self;
        }
        // the number of cells of the result, which every tile operand has too
        auto cells = this->result()->shape().cells();

        // two tiles
        if constexpr (tile_c<op1_type> && tile_c<op2_type>) {
            // get read access to the operands
            const auto & op1 = this->op1()->read();
            const auto & op2 = this->op2()->read();
            // and write access to the result
            auto & result = this->result()->write();
            // go through the cells
            for (decltype(cells) cell = 0; cell < cells; ++cell) {
                // combine the values of the operands
                result[cell] = operation(op1[cell], op2[cell]);
            }
        }
        // a tile and a scalar
        else if constexpr (tile_c<op1_type>) {
            // get read access to the operands
            const auto & op1 = this->op1()->read();
            const auto op2 = this->op2()->read();
            // and write access to the result
            auto & result = this->result()->write();
            // go through the cells
            for (decltype(cells) cell = 0; cell < cells; ++cell) {
                // combine each value of the tile with the scalar
                result[cell] = operation(op1[cell], op2);
            }
        }
        // a scalar and a tile
        else {
            // get read access to the operands
            const auto op1 = this->op1()->read();
            const auto & op2 = this->op2()->read();
            // and write access to the result
            auto & result = this->result()->write();
            // go through the cells
            for (decltype(cells) cell = 0; cell < cells; ++cell) {
                // combine the scalar with each value of the tile
                result[cell] = operation(op1, op2[cell]);
            }
        }
    }

    // all done
    return self;
}


// implementation details
template <class operationT, class op1T, class op2T, class resultT>
    requires pyre::flow::factories::operators::arithmetic_c<operationT, op1T, op2T, resultT>
auto
pyre::flow::factories::operators::Arithmetic<operationT, op1T, op2T, resultT>::aligned() -> bool
{
    // the shape of the result
    auto shape = this->result()->shape();
    // assume the operands agree
    auto ok = true;
    // a tile in the first operand
    if constexpr (tile_c<op1_type>) {
        // must have the shape of the result
        ok = ok && this->op1()->shape() == shape;
    }
    // and so must a tile in the second
    if constexpr (tile_c<op2_type>) {
        // so compare them too
        ok = ok && this->op2()->shape() == shape;
    }
    // if they do
    if (ok) {
        // there is nothing to report
        return true;
    }

    // otherwise, make a channel
    auto channel = pyre::journal::error_t("pyre.flow.factories.operators." + traits_type::name());
    // say who
    channel
        // where
        << pyre::journal::at()
        // who
        << traits_type::name() << " factory '" << this->name() << "' at " << this << ":"
        << pyre::journal::newline
        // what
        << "the tiles of its slots have different shapes"
        << pyre::journal::newline
        // indent
        << pyre::journal::indent;
    // the first operand, when it is a tile
    if constexpr (tile_c<op1_type>) {
        // show its shape
        channel << "op1: " << this->op1()->shape() << pyre::journal::newline;
    }
    // the second operand, when it is a tile
    if constexpr (tile_c<op2_type>) {
        // show its shape
        channel << "op2: " << this->op2()->shape() << pyre::journal::newline;
    }
    // finish
    channel
        // the result
        << "result: " << shape
        << pyre::journal::newline
        // outdent
        << pyre::journal::outdent
        // flush
        << pyre::journal::endl;
    // and report the mismatch, in case errors are not fatal
    return false;
}


