// code guard
#pragma once


// my declarations
#include "Real.h"


// simulate my c++ declaration
template <class signalT, class realT>
auto
pyre::flow::factories::selectors::Real<signalT, realT>::declSelf() -> string_type
{
    // the type alias, with the declarations of my slots
    return "pyre::flow::factories::selectors::real_t<" + signal_type::declSelf() + ", "
         + real_type::declSelf() + ">";
}


// the human readable form of my class name
template <class signalT, class realT>
auto
pyre::flow::factories::selectors::Real<signalT, realT>::className() -> string_type
{
    // my kind
    return "Real";
}


// the descriptions of my slots
template <class signalT, class realT>
auto
pyre::flow::factories::selectors::Real<signalT, realT>::declSlots() -> const slots_type &
{
    // my slots, in the order i declare them
    static const slots_type table {
        slot_type::input<signal_type>("signal"),
        slot_type::output<real_type>("real"),
    };
    // hand them off
    return table;
}


// the descriptions of my settings
template <class signalT, class realT>
auto
pyre::flow::factories::selectors::Real<signalT, realT>::declSettings() -> const settings_type &
{
    // i have none that can be changed by name
    static const settings_type table {};
    // hand them off
    return table;
}


// the descriptions of my slots
template <class signalT, class realT>
auto
pyre::flow::factories::selectors::Real<signalT, realT>::slots() const -> const slots_type &
{
    // the ones of my type
    return declSlots();
}


// the descriptions of my settings
template <class signalT, class realT>
auto
pyre::flow::factories::selectors::Real<signalT, realT>::settings() const -> const settings_type &
{
    // the ones of my type
    return declSettings();
}


// factory
template <class signalT, class realT>
auto
pyre::flow::factories::selectors::Real<signalT, realT>::create(const name_type & name)
    -> factory_ref_type
{
    // build an instance and wrap it in a shared pointer
    auto ref = std::make_shared<Real>(sentinel_type(), name);
    // make a channel
    auto channel = pyre::journal::debug_t("pyre.flow.factories.selectors.real.create");
    // show me
    channel
        // where
        << pyre::journal::at()
        // the factory
        << "real '" << ref->name() << "' at " << ref.get() << ": create"
        << pyre::journal::newline
        // flush
        << pyre::journal::endl;
    // return it
    return ref;
}

// constructor
template <class signalT, class realT>
pyre::flow::factories::selectors::Real<signalT, realT>::Real(
    sentinel_type sentinel, const name_type & name) :
    // superclass
    super_type(sentinel, name)
{}

// destructor
template <class signalT, class realT>
pyre::flow::factories::selectors::Real<signalT, realT>::~Real()
{}

// accessors
template <class signalT, class realT>
auto
pyre::flow::factories::selectors::Real<signalT, realT>::signal() -> signal_ref_type
{
    // look up the product bound to my {signal} slot and return it
    return std::dynamic_pointer_cast<signal_type>(input("signal"));
}

template <class signalT, class realT>
auto
pyre::flow::factories::selectors::Real<signalT, realT>::real() -> real_ref_type
{
    // look up the product bound to my {real} slot and return it
    return std::dynamic_pointer_cast<real_type>(output("real"));
}

// mutators
template <class signalT, class realT>
auto
pyre::flow::factories::selectors::Real<signalT, realT>::signal(signal_ref_type signal)
    -> factory_ref_type
{
    // connect my {signal} slot
    addInput("signal", std::static_pointer_cast<pyre::flow::protocols::Product>(signal));
    // make a self reference
    auto self = std::dynamic_pointer_cast<Real>(ref());
    // and return it
    return self;
}

template <class signalT, class realT>
auto
pyre::flow::factories::selectors::Real<signalT, realT>::real(real_ref_type real) -> factory_ref_type
{
    // connect my {real} slot
    addOutput("real", std::static_pointer_cast<pyre::flow::protocols::Product>(real));
    // make a self reference
    auto self = std::dynamic_pointer_cast<Real>(ref());
    // and return it
    return self;
}

template <class signalT, class realT>
auto
pyre::flow::factories::selectors::Real<signalT, realT>::make(
    const name_type & slot, super_type::product_ref_type product) -> super_type::factory_ref_type
{
    // chain up
    auto self = super_type::make(slot, product);

    // get my input
    auto s = signal();
    // get my output
    auto r = real();

    // the bound products must be shape compatible; the current implementation only requires
    // that products have the same number of cells
    auto pixels = s->shape().cells();
    // verify consistency
    bool ok = pixels == r->shape().cells();
    // if something is off
    if (!ok) {
        // make a channel
        auto channel = pyre::journal::error_t("pyre.flow.factories.selectors.real");
        // complain
        channel
            // where
            << pyre::journal::at()
            // who
            << "real factory '" << name() << "' at " << this << ":"
            << pyre::journal::newline
            // what
            << "shape mismatch in the input and output slots"
            << pyre::journal::newline
            // inputs
            << "inputs "
            << pyre::journal::newline
            // indent
            << pyre::journal::indent
            // signal
            << "signal: " << s->shape()
            << pyre::journal::newline
            // outdent
            << pyre::journal::outdent
            // outputs
            << "outputs: "
            << pyre::journal::newline
            // indent
            << pyre::journal::indent
            // details
            // real
            << "real: " << r->shape()
            << pyre::journal::newline
            // outdent
            << pyre::journal::outdent
            // flush
            << pyre::journal::endl;
        // and bail, just in case errors aren't fatal
        return self;
    }

    // get the data buffers
    // inputs
    auto sData = s->read();
    // outputs
    auto rData = r->write();

    // go through the cells
    for (auto pixel = 0; pixel < pixels; ++pixel) {
        // read
        auto sValue = sData[pixel];
        // compute the real part and write
        rData[pixel] = sValue.real();
    }

    // all done
    return self;
}


// end of file
