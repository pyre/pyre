// code guard
#pragma once


// my declarations
#include "Tile.h"


// simulate my c++ declaration
template <class gridT>
auto
pyre::flow::products::Tile<gridT>::declSelf() -> string_type
{
    // the type alias, with the declaration of my grid
    return "pyre::flow::products::tile_t<" + grid_type::declSelf() + ">";
}


// the human readable form of my class name
template <class gridT>
auto
pyre::flow::products::Tile<gridT>::className() -> string_type
{
    // my kind, and the name of my grid
    return "Tile" + grid_type::className();
}


// factory
template <class gridT>
auto
pyre::flow::products::Tile<gridT>::create(const name_type & name, shape_type shape) -> ref_type
{
    // build an instance and wrap it in a shared pointer
    auto ref = std::make_shared<Tile>(sentinel_type(), name, shape);
    // make a channel
    auto channel = pyre::journal::debug_t("pyre.flow.products.tile");
    // let me know
    channel
        // where
        << pyre::journal::at()
        // mark
        << "tile '" << ref->name() << "' at " << ref.get() << ": create"
        << pyre::journal::newline
        // flush
        << pyre::journal::endl;
    // hand off the ref
    return ref;
}

template <class gridT>
auto
pyre::flow::products::Tile<gridT>::create(const name_type & name, shape_type shape, cell_type value)
    -> ref_type
{
    // build an instance and wrap it in a shared pointer
    auto ref = std::make_shared<Tile>(sentinel_type(), name, shape, value);
    // make a channel
    auto channel = pyre::journal::debug_t("pyre.flow.products.tile");
    // let me know
    channel
        // where
        << pyre::journal::at()
        // mark
        << "tile '" << ref->name() << "' at " << ref.get() << ": create"
        << pyre::journal::newline
        // flush
        << pyre::journal::endl;
    // hand off the ref
    return ref;
}

// destructor
template <class gridT>
pyre::flow::products::Tile<gridT>::~Tile()
{
    // make a channel
    auto channel = pyre::journal::debug_t("pyre.flow.products.tile");
    // let me know
    channel
        // where
        << pyre::journal::at()
        // mark
        << "tile '" << name() << "' at " << this << ": destroy"
        << pyre::journal::newline
        // flush
        << pyre::journal::endl;

    // all done
    return;
}

// constructor
template <class gridT>
pyre::flow::products::Tile<gridT>::Tile(
    sentinel_type sentinel, const name_type & name, shape_type shape) :
    // base class: start out stale, since my cells hold nothing meaningful yet
    pyre::flow::protocols::Product(sentinel, name, true),
    // members
    _data { packing_type(shape), shape.cells() }
{}

template <class gridT>
pyre::flow::products::Tile<gridT>::Tile(
    sentinel_type sentinel, const name_type & name, shape_type shape, cell_type value) :
    // base class: start out fresh, since my cells hold {value}
    pyre::flow::protocols::Product(sentinel, name, false),
    // members
    _data { packing_type(shape), shape.cells() }
{
    // initialize
    std::fill(_data.begin(), _data.end(), value);
}

// accessors
template <class gridT>
auto
pyre::flow::products::Tile<gridT>::shape() const -> shape_type
{
    // easy enough
    return _data.packing().shape();
}

// mutators
template <class gridT>
auto
pyre::flow::products::Tile<gridT>::value(cell_type value) -> void
{
    // initialize
    std::fill(_data.begin(), _data.end(), value);
    // invalidate my downstream graph
    flush();
    // but mark me as clean
    clean();
    // all done
    return;
}

// value access by factories
template <class gridT>
auto
pyre::flow::products::Tile<gridT>::read() -> const grid_type &
{
    // refresh me
    make();
    // return my value
    return _data;
}

template <class gridT>
auto
pyre::flow::products::Tile<gridT>::write() -> grid_type &
{
    // whatever is computed from my cells is about to be out of date; nobody can tell when the
    // writing is over, so say so now
    flush();
    // grant access to my data
    return _data;
}


// end of file
