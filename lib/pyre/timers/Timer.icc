// code guard
#pragma once


// my declarations
#include "Timer.h"


// metamethods
template <class clockT, template <class, class> class proxyT>
pyre::timers::Timer<clockT, proxyT>::Timer(const name_type & name) :
    // lookup my movement
    proxy_type(_registry.lookup(name)),
    // save my name
    _name(name)
{}


// accessors
template <class clockT, template <class, class> class proxyT>
auto
pyre::timers::Timer<clockT, proxyT>::name() const
{
    // easy enough
    return _name;
}


// static interface
template <class clockT, template <class, class> class proxyT>
auto
pyre::timers::Timer<clockT, proxyT>::type() -> typename clock_type::string_type
{
    // ask my movement
    return clock_type::type();
}

template <class clockT, template <class, class> class proxyT>
auto
pyre::timers::Timer<clockT, proxyT>::registry() -> registry_reference
{
    // easy enough
    return _registry;
}


// end of file
