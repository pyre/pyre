// code guard
#pragma once

// my declarations
#include "accessors.h"


// the setter of a property made from a method; the method may be declared by a base that python
// never sees, so it is invoked on an instance of the class bound by {cls}, and whatever it returns
// is discarded, so that python sees a setter that returns nothing
template <class classT, class returnT, class ownerT, class argT, bool except>
auto
pyre::py::setter(const classT & cls, returnT (ownerT::*method)(argT) noexcept(except))
    -> py::cpp_function
{
    // the class bound by {cls}
    using bound_t = typename classT::type;
    // build the setter, and return it
    return py::cpp_function(
        // invoke the method
        [method](bound_t & self, argT value) -> void {
            // on {value}
            (self.*method)(value);
            // all done
            return;
        },
        // as a method of the class bound by {cls}, which lets the name of its parameter skip over
        // {self}
        py::is_method(cls),
        // with its parameter named
        py::arg("value"));
}


// the setter of a property made from a callable
template <class classT, class callableT>
auto
pyre::py::setter(const classT & cls, callableT callable) -> py::cpp_function
{
    // build the setter, and return it
    return py::cpp_function(
        // the callable
        std::move(callable),
        // as a method of the class bound by {cls}
        py::is_method(cls),
        // with its parameter named
        py::arg("value"));
}


// the getter of a property made from a data member; the property binds it with the policy that
// keeps the instance alive while python holds a reference to the field
template <class classT, class ownerT, class fieldT>
    requires(!std::is_function_v<fieldT>)
auto
pyre::py::getter(const classT & cls, fieldT ownerT::* field) -> py::cpp_function
{
    // the class bound by {cls}, which may inherit the field from a base python never sees
    using bound_t = typename classT::type;
    // build the getter, and return it
    return py::cpp_function(
        // read my field
        [field](const bound_t & self) -> const fieldT & {
            // and hand it over
            return self.*field;
        },
        // as a method of the class bound by {cls}
        py::is_method(cls));
}


// the setter of a property made from a data member
template <class classT, class ownerT, class fieldT>
    requires(!std::is_function_v<fieldT>)
auto
pyre::py::setter(const classT & cls, fieldT ownerT::* field) -> py::cpp_function
{
    // the class bound by {cls}, which may inherit the field from a base python never sees
    using bound_t = typename classT::type;
    // build the setter, and return it
    return py::cpp_function(
        // write my field
        [field](bound_t & self, const fieldT & value) -> void {
            // store {value}
            self.*field = value;
            // all done
            return;
        },
        // as a method of the class bound by {cls}
        py::is_method(cls),
        // and as a setter
        py::is_setter(),
        // with its parameter named
        py::arg("value"));
}


