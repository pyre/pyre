// code guard
#pragma once


// support
#include "AnyMosaic.h"


// type-erase a mosaic into the single class the bindings expose
template <class gridT>
auto
pyre::py::grid::anyMosaic(const gridT & mosaic, string_t cell) -> AnyMosaic
{
    // keep a copy of the source grid alive behind a shared handle: its storage shares the page
    // table, so every page stays put for as long as any of the closures below is callable
    auto owner = std::make_shared<gridT>(mosaic);
    // pull the layout out while its type is concrete; it travels by value
    auto packing = owner->packing();
    // and the storage, whose copies are views of the same store
    auto storage = owner->storage();

    // count the resident pages
    AnyMosaic::census_type residents = [storage]() -> AnyMosaic::size_type {
        // the store keeps the census
        return storage.residents();
    };

    // carve the pane over one tile
    AnyMosaic::pane_maker_type pane = [owner](const AnyMosaic::index_type & t) -> AnyGrid {
        // the page that backs the tile
        auto ordinal = owner->packing().tileOrdinal(t);
        // materialize it, allocating it on first touch; this is the demand-driven half of the
        // out-of-core workflow
        owner->storage().reside(ordinal);
        // share ownership of its block: the pane stays alive through a {release} of the page
        // and even the death of the mosaic, for as long as python holds on; a release severs
        // the pane from the store, so a pane made after the tile is touched again addresses
        // whatever fresh page takes its place
        auto block = owner->storage().handle(ordinal);
        // carve the pane: a dense grid over the page, addressed in the mosaic's index space
        auto pane = owner->pane(t);
        // describe it to python over the page's block, pinned by the shared handle
        return describe(pane, "pane", pane.data(), std::shared_ptr<void>(block, block.get()));
    };

    // read the page state bits
    AnyMosaic::probe_type resident = [storage](AnyMosaic::size_type ordinal) -> bool {
        // whether the page has been allocated
        return storage.resident(ordinal);
    };
    AnyMosaic::probe_type valid = [storage](AnyMosaic::size_type ordinal) -> bool {
        // whether the client has deposited meaningful content
        return storage.valid(ordinal);
    };
    AnyMosaic::probe_type clean = [storage](AnyMosaic::size_type ordinal) -> bool {
        // whether the content matches the client's backing store
        return storage.clean(ordinal);
    };

    // and flip them
    AnyMosaic::mark_type validate = [storage](AnyMosaic::size_type ordinal) -> void {
        // the page now holds meaningful content
        storage.validate(ordinal);
        // all done
        return;
    };
    AnyMosaic::mark_type taint = [storage](AnyMosaic::size_type ordinal) -> void {
        // the page has diverged from the backing store
        storage.taint(ordinal);
        // all done
        return;
    };
    AnyMosaic::mark_type flush = [storage](AnyMosaic::size_type ordinal) -> void {
        // the page matches the backing store again
        storage.flush(ordinal);
        // all done
        return;
    };
    AnyMosaic::mark_type release = [storage](AnyMosaic::size_type ordinal) -> void {
        // the page returns to the never-touched state; outstanding panes keep their block
        storage.release(ordinal);
        // all done
        return;
    };

    // name the cell type while it is still concrete, in its writable spelling
    using cell_t = std::remove_const_t<typename gridT::value_type>;

    // lift the cell at an index into python; the caller has verified that its page is resident
    AnyMosaic::reader_type read = [owner](const AnyMosaic::index_type & index) -> py::object {
        // pull the cell through the mosaic's own map and cast it across
        return py::cast((*owner)[index]);
    };
    // deposit a python value into the cell at an index, its companion
    AnyMosaic::writer_type write =
        [owner](const AnyMosaic::index_type & index, const py::object & value) -> void {
        // the page that holds the cell
        auto ordinal = owner->packing().tileOrdinal(owner->packing().tileOf(index));
        // materialize it, in case this is its first touch
        owner->storage().reside(ordinal);
        // deposit the converted value through the mosaic's own map
        (*owner)[index] = value.cast<cell_t>();
        // the write is a divergence this closure can see, so record it
        owner->storage().taint(ordinal);
        // all done
        return;
    };

    // assemble the type-erased mosaic
    return AnyMosaic(
        // the layout
        std::move(packing),
        // the name of the cell type
        std::move(cell),
        // the census
        std::move(residents),
        // the pane maker
        std::move(pane),
        // the page state probes
        std::move(resident), std::move(valid), std::move(clean),
        // the page state marks
        std::move(validate), std::move(taint), std::move(flush), std::move(release),
        // and the pair that moves a cell to and from python
        std::move(read), std::move(write));
}


// assemble a type-erased mosaic from its layout and the closures that reach its storage
inline pyre::py::grid::AnyMosaic::AnyMosaic(
    packing_type packing, string_t cell, census_type residents, pane_maker_type pane,
    probe_type resident, probe_type valid, probe_type clean, mark_type validate, mark_type taint,
    mark_type flush, mark_type release, reader_type read, writer_type write) :
    // adopt the layout
    _packing { std::move(packing) },
    // the name of the cell type
    _cell { std::move(cell) },
    // the census
    _residents { std::move(residents) },
    // the pane maker
    _pane { std::move(pane) },
    // the page state probes
    _resident { std::move(resident) },
    _valid { std::move(valid) },
    _clean { std::move(clean) },
    // the page state marks
    _validate { std::move(validate) },
    _taint { std::move(taint) },
    _flush { std::move(flush) },
    _release { std::move(release) },
    // and the pair that moves a cell to and from python
    _read { std::move(read) },
    _write { std::move(write) }
{}


// accessors

// the extent along each axis
inline auto
pyre::py::grid::AnyMosaic::shape() const -> const shape_type &
{
    // the layout knows
    return _packing.shape();
}

// the smallest addressable index
inline auto
pyre::py::grid::AnyMosaic::origin() const -> const index_type &
{
    // the layout knows
    return _packing.origin();
}

// the number of axes
inline auto
pyre::py::grid::AnyMosaic::rank() const -> std::size_t
{
    // the layout knows
    return _packing.rank();
}

// the extent of the grid of tiles
inline auto
pyre::py::grid::AnyMosaic::tiles() const -> const shape_type &
{
    // the layout knows
    return _packing.tiles();
}

// the extent of one tile
inline auto
pyre::py::grid::AnyMosaic::tileShape() const -> const shape_type &
{
    // the layout knows
    return _packing.tileShape();
}

// the number of cells the storage supplies
inline auto
pyre::py::grid::AnyMosaic::cells() const -> size_type
{
    // every tile at full size, padding included
    return _packing.cells();
}

// the name of my cell type
inline auto
pyre::py::grid::AnyMosaic::cell() const -> const string_t &
{
    // hand out the name
    return _cell;
}

// the number of pages that are actually resident
inline auto
pyre::py::grid::AnyMosaic::residents() const -> size_type
{
    // ask the storage
    return _residents();
}


// tiling interface

// the coordinates, in the grid of tiles, of the tile a given index falls in
inline auto
pyre::py::grid::AnyMosaic::tileOf(const index_type & index) const -> index_type
{
    // the index must name one axis per rank
    if (index.size() != rank()) {
        // anything else is a caller mistake
        throw py::index_error("the index must have one coordinate per axis");
    }
    // go through the axes
    for (std::size_t axis = 0; axis < rank(); ++axis) {
        // the index must fall inside my box
        if (index[axis] < origin()[axis] || index[axis] >= origin()[axis] + shape()[axis]) {
            // otherwise reject it
            throw py::index_error("index out of range");
        }
    }
    // the layout knows
    return _packing.tileOf(index);
}

// the tiles a box with the given anchor and extent touches
inline auto
pyre::py::grid::AnyMosaic::tilesOverlapping(
    const index_type & base, const shape_type & extent) const -> std::vector<index_type>
{
    // the box must name one axis per rank
    if (base.size() != rank() || extent.size() != rank()) {
        // anything else is a caller mistake
        throw py::index_error("the box must have one coordinate and one extent per axis");
    }
    // go through the axes
    for (std::size_t axis = 0; axis < rank(); ++axis) {
        // the box must be at least one cell wide
        if (extent[axis] < 1) {
            // otherwise there is nothing to touch
            throw py::value_error("the box must be at least one cell wide along each axis");
        }
        // and it must fit inside mine
        if (base[axis] < origin()[axis]
            || base[axis] + extent[axis] > origin()[axis] + shape()[axis]) {
            // otherwise reject it
            throw py::index_error("the box reaches outside the mosaic");
        }
    }
    // ask the layout for the touched tiles, as a box in tile space
    auto touched = pyre::grid::tilesOverlapping(_packing, base, extent);
    // room for the answer
    std::vector<index_type> result;
    // it holds one set of coordinates per touched tile
    result.reserve(touched.cells());
    // go through the touched tiles
    for (const auto & t : touched) {
        // and collect each one
        result.push_back(t);
    }
    // hand off the working set
    return result;
}

// the pane over a tile
inline auto
pyre::py::grid::AnyMosaic::pane(const index_type & tile) const -> AnyGrid
{
    // guard the coordinates; the ordinal itself is recomputed by the maker, which addresses
    // the storage in its own concrete terms
    _ordinal(tile);
    // carve the pane, materializing the tile's page on first touch
    return _pane(tile);
}


// item access

// {m[i, j, ...]}: the cell at a full integer index
inline auto
pyre::py::grid::AnyMosaic::getitem(const py::object & key) const -> py::object
{
    // resolve the key into box coordinates
    auto index = _index(key);
    // the page that backs the cell
    auto ordinal = _packing.tileOrdinal(_packing.tileOf(index));
    // a cell on a page that was never brought in holds nothing meaningful
    if (!_resident(ordinal)) {
        // so reading it is a caller mistake; refuse, with an exception python can catch
        throw py::value_error("reading a cell on a page that is not resident");
    }
    // lift the cell into python
    return _read(index);
}

// {m[i, j, ...] = v}: write {v} into the cell at a full integer index
inline auto
pyre::py::grid::AnyMosaic::setitem(const py::object & key, const py::object & value) const -> void
{
    // resolve the key into box coordinates and deposit the value; the writer materializes the
    // page on first touch and taints it, since the divergence is visible from here
    return _write(_index(key), value);
}


// page state

// whether a tile's page has been allocated
inline auto
pyre::py::grid::AnyMosaic::resident(const index_type & tile) const -> bool
{
    // fold the tile onto its page and probe it
    return _resident(_ordinal(tile));
}

// whether the client has deposited meaningful content in it
inline auto
pyre::py::grid::AnyMosaic::valid(const index_type & tile) const -> bool
{
    // fold the tile onto its page and probe it
    return _valid(_ordinal(tile));
}

// whether its content matches the client's backing store
inline auto
pyre::py::grid::AnyMosaic::clean(const index_type & tile) const -> bool
{
    // fold the tile onto its page and probe it
    return _clean(_ordinal(tile));
}

// record that the client has deposited meaningful content in a tile's page
inline auto
pyre::py::grid::AnyMosaic::validate(const index_type & tile) const -> void
{
    // fold the tile onto its page and mark it
    return _validate(_ordinal(tile));
}

// record that the client has written to a tile's page
inline auto
pyre::py::grid::AnyMosaic::taint(const index_type & tile) const -> void
{
    // fold the tile onto its page and mark it
    return _taint(_ordinal(tile));
}

// make my backing store agree about a tile
inline auto
pyre::py::grid::AnyMosaic::flush(const index_type & tile) const -> void
{
    // guard the coordinates and fold the tile onto its page
    auto ordinal = _ordinal(tile);
    // when i have a backing store
    if (_sink) {
        // it does the i/o, and marks the page as its last step
        return _sink(tile);
    }
    // otherwise the client did the i/o themselves; just record the agreement
    return _flush(ordinal);
}

// let go of a tile's page
inline auto
pyre::py::grid::AnyMosaic::release(const index_type & tile) const -> void
{
    // fold the tile onto its page and let it go
    return _release(_ordinal(tile));
}


// implementation details

// guard tile coordinates and fold them to the ordinal of the page that backs the tile
inline auto
pyre::py::grid::AnyMosaic::_ordinal(const index_type & tile) const -> size_type
{
    // the coordinates must name one axis per rank
    if (tile.size() != rank()) {
        // anything else is a caller mistake
        throw py::index_error("the tile must have one coordinate per axis");
    }
    // go through the axes
    for (std::size_t axis = 0; axis < rank(); ++axis) {
        // the coordinates must fall inside the tile grid
        if (tile[axis] < 0 || tile[axis] >= tiles()[axis]) {
            // otherwise reject them
            throw py::index_error("tile out of range");
        }
    }
    // the layout knows how the tiles are numbered
    return _packing.tileOrdinal(tile);
}

// resolve a python key into box coordinates
inline auto
pyre::py::grid::AnyMosaic::_index(const py::object & key) const -> index_type
{
    // room for the answer
    index_type index;
    // a tuple supplies one coordinate per axis
    if (py::isinstance<py::tuple>(key)) {
        // go through its items
        for (const auto & item : key.cast<py::tuple>()) {
            // and adopt each one as a coordinate
            index.push_back(item.cast<size_type>());
        }
    } else {
        // anything else must be a lone integer, which addresses a one dimensional mosaic
        index.push_back(key.cast<size_type>());
    }
    // the key must name one coordinate per axis
    if (index.size() != rank()) {
        // anything else is a caller mistake
        throw py::index_error("the index must have one coordinate per axis");
    }
    // go through the axes
    for (std::size_t axis = 0; axis < rank(); ++axis) {
        // a coordinate below the origin counts back from the end of its axis
        if (index[axis] < origin()[axis]) {
            // so wrap it around
            index[axis] += origin()[axis] + shape()[axis];
        }
        // by now, the coordinate must fall inside my box
        if (index[axis] < origin()[axis] || index[axis] >= origin()[axis] + shape()[axis]) {
            // otherwise reject it
            throw py::index_error("index out of range");
        }
    }
    // hand off the coordinates
    return index;
}


// the backing store

// bind the hooks that move tiles between me and my backing store
inline auto
pyre::py::grid::AnyMosaic::connect(source_type fill, sink_type flush) -> void
{
    // adopt the pair
    _source = std::move(fill);
    _sink = std::move(flush);
    // all done
    return;
}

// whether i have a backing store
inline auto
pyre::py::grid::AnyMosaic::connected() const -> bool
{
    // i do when my hooks are bound
    return static_cast<bool>(_source) && static_cast<bool>(_sink);
}

// pull the chunk at {tile} from my backing store into its page
inline auto
pyre::py::grid::AnyMosaic::fill(const index_type & tile) const -> void
{
    // without a backing store there is nowhere to pull from
    if (!_source) {
        // so this is a caller mistake
        throw std::runtime_error("this mosaic has no backing store");
    }
    // guard the coordinates
    _ordinal(tile);
    // and delegate to whoever built me
    return _source(tile);
}

// pull every chunk of my box
inline auto
pyre::py::grid::AnyMosaic::fill() const -> void
{
    // without a backing store there is nowhere to pull from
    if (!_source) {
        // so this is a caller mistake
        throw std::runtime_error("this mosaic has no backing store");
    }
    // go through every tile in my box
    for (const auto & tile :
         pyre::grid::tilesOverlapping(_packing, _packing.origin(), _packing.shape())) {
        // and pull each one
        _source(tile);
    }
    // all done
    return;
}

// make my backing store agree with me
inline auto
pyre::py::grid::AnyMosaic::flush() const -> void
{
    // without a backing store there is nowhere to push to
    if (!_sink) {
        // so this is a caller mistake
        throw std::runtime_error("this mosaic has no backing store");
    }
    // go through every tile in my box
    for (const auto & tile :
         pyre::grid::tilesOverlapping(_packing, _packing.origin(), _packing.shape())) {
        // the page that backs this one
        auto ordinal = _packing.tileOrdinal(tile);
        // pages the producer never touched hold nothing, and pages that match the backing
        // store already need no saving
        if (!_resident(ordinal) || _clean(ordinal)) {
            // so skip them
            continue;
        }
        // push the rest
        _sink(tile);
    }
    // all done
    return;
}


// end of file
