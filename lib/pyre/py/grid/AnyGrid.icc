// code guard
#pragma once


// support
#include "AnyGrid.h"


// describe a grid in the buffer protocol's terms, over a block someone else keeps alive
template <class gridT>
auto
pyre::py::grid::describe(
    const gridT & grid, string_t strategy, void * data, std::shared_ptr<void> owner) -> AnyGrid
{
    // name the cell type
    using value_t = typename gridT::value_type;
    // the writable spelling of it, so a read-only source still yields a compilable writer
    using cell_t = std::remove_const_t<value_t>;
    // and the native scalar behind it, which is what python sees; a byte ordered cell swaps on
    // the way through, so python never meets the wrapper
    using native_t = pyre::memory::native_t<cell_t>;
    // and the layout
    const auto & packing = grid.packing();

    // the extent along each axis
    std::vector<AnyGrid::size_type> shape;
    // copied out of the layout
    for (auto s : packing.shape()) {
        shape.push_back(s);
    }
    // and the stride along each axis, in cells
    std::vector<AnyGrid::size_type> strides;
    // likewise
    for (auto s : packing.strides()) {
        strides.push_back(s);
    }

    // whether python may write through depends on the storage's cell type
    const bool writable = gridT::storage_type::cell_type::writable();

    // lift one cell from memory into python, knowing its type here where it is still concrete
    AnyGrid::reader_type read = [](const void * p) -> py::object {
        // interpret the address as a cell, read it as a native value, and cast it across
        return py::cast(static_cast<native_t>(*static_cast<const cell_t *>(p)));
    };
    // deposit one cell from python into memory, its companion
    AnyGrid::writer_type write = [](void * p, const py::object & v) -> void {
        // interpret the address as a cell and assign the converted native value
        *static_cast<cell_t *>(p) = v.cast<native_t>();
        // all done
        return;
    };

    // assemble the type-erased grid over the block {owner} keeps alive
    return AnyGrid(
        // the block starts here
        data,
        // one cell is this wide
        sizeof(value_t),
        // described by this struct code, byte order marker and all
        pyre::py::memory::format<value_t>(),
        // over this shape
        std::move(shape),
        // with these strides
        std::move(strides),
        // and this mutability
        writable,
        // backed by this storage strategy
        std::move(strategy),
        // held alive by whatever the caller supplied
        std::move(owner),
        // moving cells to and from python by these
        std::move(read), std::move(write));
}


// type-erase a grid whose storage owns its cells
template <class gridT>
auto
pyre::py::grid::anyGrid(const gridT & grid, string_t strategy) -> AnyGrid
{
    // keep the source grid alive behind a type-erased handle: copying it bumps the storage's
    // shared reference count, so its cells outlive this call for as long as python holds on
    auto owner = std::make_shared<gridT>(grid);
    // the block address; the buffer protocol wants a mutable pointer even for read-only
    // cells, so shed the constness here: {writable} in the description is what actually
    // guards writes, and {setitem} refuses before any writer is reached
    auto data = const_cast<void *>(static_cast<const void *>(owner->data()));
    // the kept copy's storage is where the block lives; describe over it, held alive by the copy
    return describe(*owner, std::move(strategy), data, owner);
}


// assemble a type-erased grid from its parts
inline pyre::py::grid::AnyGrid::AnyGrid(
    void * data, std::size_t itemsize, string_t format, std::vector<size_type> shape,
    std::vector<size_type> strides, bool writable, string_t strategy, std::shared_ptr<void> owner,
    reader_type read, writer_type write) :
    // adopt the block
    _data { data },
    // its cell width
    _itemsize { itemsize },
    // its cell description
    _format { std::move(format) },
    // its shape
    _shape { std::move(shape) },
    // its strides, in cells
    _strides { std::move(strides) },
    // its mutability
    _writable { writable },
    // its storage kind
    _strategy { std::move(strategy) },
    // the handle that keeps it alive
    _owner { std::move(owner) },
    // and the pair that moves a cell to and from python
    _read { std::move(read) },
    _write { std::move(write) }
{}


// describe myself in the terms the python buffer protocol speaks
inline auto
pyre::py::grid::AnyGrid::view() -> py::buffer_info
{
    // the protocol wants strides in bytes, so scale my cell strides by the cell width
    std::vector<py::ssize_t> byteStrides;
    // one per axis
    for (auto s : _strides) {
        // from cells to bytes
        byteStrides.push_back(static_cast<py::ssize_t>(s) * static_cast<py::ssize_t>(_itemsize));
    }
    // the extents, in the protocol's own signed type
    std::vector<py::ssize_t> extents(_shape.begin(), _shape.end());
    // hand back the full description; {_writable} decides whether the buffer is read-only
    return py::buffer_info(
        _data, static_cast<py::ssize_t>(_itemsize), _format,
        static_cast<py::ssize_t>(_shape.size()), extents, byteStrides, !_writable);
}


// the extent along each axis
inline auto
pyre::py::grid::AnyGrid::shape() const -> const std::vector<size_type> &
{
    // hand out my extents
    return _shape;
}


// the distance between consecutive cells along each axis, in cells
inline auto
pyre::py::grid::AnyGrid::strides() const -> const std::vector<size_type> &
{
    // hand out my strides
    return _strides;
}


// the number of axes
inline auto
pyre::py::grid::AnyGrid::rank() const -> std::size_t
{
    // the length of my shape is my rank
    return _shape.size();
}


// whether python may write through to my cells
inline auto
pyre::py::grid::AnyGrid::writable() const -> bool
{
    // hand out my mutability
    return _writable;
}


// the storage strategy that holds my cells
inline auto
pyre::py::grid::AnyGrid::strategy() const -> const string_t &
{
    // hand out my storage kind
    return _strategy;
}


// the address of my first cell
inline auto
pyre::py::grid::AnyGrid::address() const -> std::uintptr_t
{
    // as an integer, the way python passes pointers around
    return reinterpret_cast<std::uintptr_t>(_data);
}


// turn a python index into the offset and residual layout it selects
inline auto
pyre::py::grid::AnyGrid::resolve(const py::object & key) const -> resolved
{
    // collect the per-axis indexers, however the key was spelled
    std::vector<py::object> items;
    // a tuple spreads across the leading axes
    if (py::isinstance<py::tuple>(key)) {
        // one entry per axis it mentions
        for (auto handle : py::cast<py::tuple>(key)) {
            items.push_back(py::reinterpret_borrow<py::object>(handle));
        }
    }
    // anything else indexes the first axis alone
    else {
        // a single indexer
        items.push_back(key);
    }
    // my rank bounds how many axes can be addressed
    const auto rank = _shape.size();
    // more indexers than axes is a mistake
    if (items.size() > rank) {
        // reject the excess
        throw py::index_error("too many indices for grid");
    }

    // accumulate the linear offset and the residual layout
    size_type offset = 0;
    // the extents and strides that survive
    std::vector<size_type> shape, strides;
    // until an axis escapes an integer, the index still names a single cell
    bool scalar = true;
    // walk every axis
    for (std::size_t axis = 0; axis < rank; ++axis) {
        // its extent
        const auto extent = _shape[axis];
        // and stride
        const auto stride = _strides[axis];
        // axes past the supplied indexers are taken whole
        if (axis >= items.size()) {
            // keep the axis intact
            shape.push_back(extent);
            strides.push_back(stride);
            // it is no longer a single cell
            scalar = false;
            // on to the next axis
            continue;
        }
        // the indexer for this axis
        const auto & item = items[axis];
        // a slice selects a strided run
        if (py::isinstance<py::slice>(item)) {
            // storage for the unpacked bounds
            py::ssize_t start = 0, stop = 0, step = 0, span = 0;
            // let pybind11 do the arithmetic, including negative bounds and steps
            if (!py::cast<py::slice>(item).compute(extent, &start, &stop, &step, &span)) {
                // it has already registered the right exception
                throw py::error_already_set();
            }
            // step to the first selected cell
            offset += static_cast<size_type>(start) * stride;
            // keep the axis, now the length of the run
            shape.push_back(static_cast<size_type>(span));
            // with a stride scaled by the slice step
            strides.push_back(stride * static_cast<size_type>(step));
            // a slice keeps the axis, so this is no longer a single cell
            scalar = false;
        }
        // otherwise treat it as an integer coordinate
        else {
            // read it out
            auto i = py::cast<size_type>(item);
            // fold a negative coordinate against the extent
            if (i < 0) {
                i += extent;
            }
            // reject anything still out of range
            if (i < 0 || i >= extent) {
                // out of bounds
                throw py::index_error("grid index out of range");
            }
            // pin this axis; it drops out of the residual layout
            offset += i * stride;
        }
    }
    // hand back the offset, the residual layout, and whether a single cell was named
    return { offset, std::move(shape), std::move(strides), scalar };
}


// {g[i, j, ...]}: a cell for a full index, a sub-grid for a partial or sliced one
inline auto
pyre::py::grid::AnyGrid::getitem(const py::object & key) const -> py::object
{
    // resolve the index against my layout
    const auto r = resolve(key);
    // the block address the offset lands on
    auto * cell = static_cast<char *>(_data) + r.offset * static_cast<size_type>(_itemsize);
    // a full integer index names one cell
    if (r.scalar) {
        // lift it into python
        return _read(cell);
    }
    // otherwise hand back a sub-grid that shares my cells and my keep-alive handle
    return py::cast(AnyGrid(
        // over the block the offset selected
        cell,
        // the same cell width
        _itemsize,
        // and description
        _format,
        // the residual extents
        r.shape,
        // and strides
        r.strides,
        // the same mutability
        _writable,
        // and storage kind
        _strategy,
        // pinned alive by the very handle i hold
        _owner,
        // moving cells the same way i do
        _read, _write));
}


// {g[i, j, ...] = v}: write {v} into the cell at a full integer index
inline auto
pyre::py::grid::AnyGrid::setitem(const py::object & key, const py::object & value) -> void
{
    // resolve the index against my layout
    const auto r = resolve(key);
    // an augmented assignment on a sub-grid, {g[i:j] += v}, ends by assigning back the sub-grid
    // it read, which already holds the result
    if (!r.scalar && py::isinstance<AnyGrid>(value)) {
        // get the sub-grid
        const auto & other = value.cast<const AnyGrid &>();
        // the address of the first cell {key} selects
        const auto * first =
            static_cast<const char *>(_data) + r.offset * static_cast<size_type>(_itemsize);
        // if it is the same view of my cells
        if (other._data == first && other._shape == r.shape && other._strides == r.strides) {
            // there is nothing to write
            return;
        }
    }
    // otherwise, only a full integer index, naming a single cell, may be assigned this way
    if (!r.scalar) {
        // a slice target would need array assignment; steer the caller to a view instead
        throw py::index_error(
            "only a full integer index may be assigned; index the sub-grid and write its cells");
    }
    // refuse to write through a read-only grid
    if (!_writable) {
        // say so plainly
        throw py::value_error("this grid is read-only");
    }
    // the block address the offset lands on
    auto * cell = static_cast<char *>(_data) + r.offset * static_cast<size_type>(_itemsize);
    // deposit the value
    _write(cell, value);
    // all done
    return;
}


// the dlpack device of the memory a storage strategy holds
inline auto
pyre::py::grid::interop::deviceType(const string_t & strategy) -> DLDeviceType
{
    // managed memory is reachable by the host and the device alike
    if (strategy == "managed") {
        // so say so
        return kDLCUDAManaged;
    }
    // pinned memory is host memory the device can reach
    if (strategy == "pinned") {
        // so say so
        return kDLCUDAHost;
    }
    // everything else is ordinary host memory
    return kDLCPU;
}


// the dlpack type of a cell, from its buffer protocol format
inline auto
pyre::py::grid::interop::dataType(string_t format) -> DLDataType
{
    // a byte order marker only makes sense when it names the order of the host
    if (!format.empty() && (format.front() == '<' || format.front() == '>')) {
        // the marker the host would use
        const char native = std::endian::native == std::endian::big ? '>' : '<';
        // dlpack has no way to describe cells in a foreign order
        if (format.front() != native) {
            // so refuse them
            throw py::type_error("dlpack: cells in foreign byte order");
        }
        // otherwise, drop the marker
        format.erase(0, 1);
    }
    // the signed integers
    if (format == "b")
        return { kDLInt, 8, 1 };
    if (format == "h")
        return { kDLInt, 16, 1 };
    if (format == "i")
        return { kDLInt, 32, 1 };
    if (format == "q" || format == "l")
        return { kDLInt, 64, 1 };
    // the unsigned integers
    if (format == "B")
        return { kDLUInt, 8, 1 };
    if (format == "H")
        return { kDLUInt, 16, 1 };
    if (format == "I")
        return { kDLUInt, 32, 1 };
    if (format == "Q" || format == "L")
        return { kDLUInt, 64, 1 };
    // the floating point numbers
    if (format == "f")
        return { kDLFloat, 32, 1 };
    if (format == "d")
        return { kDLFloat, 64, 1 };
    // the complex numbers, in the spelling pybind11 uses for them
    if (format == "Zf")
        return { kDLComplex, 64, 1 };
    if (format == "Zd")
        return { kDLComplex, 128, 1 };
    // anything else is a cell type the grid factories do not make
    throw py::type_error("dlpack: unsupported cell format '" + format + "'");
}


// fill in the description of a block of cells
inline auto
pyre::py::grid::interop::describe(
    DLTensor & tensor, void * data, DLDevice device, DLDataType dtype, Exported & exported) -> void
{
    // the address of the block
    tensor.data = data;
    // the device it lives on
    tensor.device = device;
    // the number of axes
    tensor.ndim = static_cast<std::int32_t>(exported.shape.size());
    // the type of the cells
    tensor.dtype = dtype;
    // the extents, which the exported context keeps alive
    tensor.shape = exported.shape.data();
    // the strides, likewise
    tensor.strides = exported.strides.data();
    // the block starts at the first cell
    tensor.byte_offset = 0;
    // all done
    return;
}


// release a versioned tensor and what it kept alive
inline auto
pyre::py::grid::interop::releaseVersioned(DLManagedTensorVersioned * tensor) -> void
{
    // the context
    delete static_cast<Exported *>(tensor->manager_ctx);
    // and the tensor
    delete tensor;
    // all done
    return;
}


// release a legacy tensor and what it kept alive
inline auto
pyre::py::grid::interop::releaseLegacy(DLManagedTensor * tensor) -> void
{
    // the context
    delete static_cast<Exported *>(tensor->manager_ctx);
    // and the tensor
    delete tensor;
    // all done
    return;
}


// the destructor of a capsule with a versioned tensor
inline auto
pyre::py::grid::interop::destroyVersioned(PyObject * capsule) -> void
{
    // a consumer that imported the tensor renamed the capsule, and owns the tensor
    if (PyCapsule_IsValid(capsule, "used_dltensor_versioned")) {
        // so there is nothing left to do
        return;
    }
    // otherwise, nobody took the tensor
    auto * tensor = static_cast<DLManagedTensorVersioned *>(
        PyCapsule_GetPointer(capsule, "dltensor_versioned"));
    // if there is one
    if (tensor != nullptr) {
        // release it
        releaseVersioned(tensor);
    }
    // all done
    return;
}


// the destructor of a capsule with a legacy tensor
inline auto
pyre::py::grid::interop::destroyLegacy(PyObject * capsule) -> void
{
    // a consumer that imported the tensor renamed the capsule, and owns the tensor
    if (PyCapsule_IsValid(capsule, "used_dltensor")) {
        // so there is nothing left to do
        return;
    }
    // otherwise, nobody took the tensor
    auto * tensor = static_cast<DLManagedTensor *>(PyCapsule_GetPointer(capsule, "dltensor"));
    // if there is one
    if (tensor != nullptr) {
        // release it
        releaseLegacy(tensor);
    }
    // all done
    return;
}


// the cuda array interface spelling of a cell type, from its buffer protocol format
inline auto
pyre::py::grid::interop::typeString(const string_t & format) -> string_t
{
    // the dlpack description of the cell, so the two protocols agree
    const auto dtype = dataType(format);
    // the kind of number, the way numpy spells it
    const char kind = dtype.code == kDLInt   ? 'i' :
                      dtype.code == kDLUInt  ? 'u' :
                      dtype.code == kDLFloat ? 'f' :
                                               'c';
    // the byte order of the host
    const char order = std::endian::native == std::endian::big ? '>' : '<';
    // the order, the kind, and the width in bytes
    return string_t(1, order) + kind + std::to_string(dtype.bits / 8);
}


// the {(device_type, device_id)} pair that says where my cells live
inline auto
pyre::py::grid::AnyGrid::dlpackDevice() const -> std::pair<std::int32_t, std::int32_t>
{
    // every storage strategy lives at device index zero
    return { interop::deviceType(_strategy), 0 };
}


// a capsule with the dlpack description of my cells
inline auto
pyre::py::grid::AnyGrid::dlpack(bool versioned) const -> py::capsule
{
    // what keeps my cells and my layout alive for as long as the tensor is held
    auto * exported = new interop::Exported {
        // my handle
        _owner,
        // my extents, in the integer type the protocol wants
        std::vector<std::int64_t>(_shape.begin(), _shape.end()),
        // my strides, in cells, the way the protocol wants them
        std::vector<std::int64_t>(_strides.begin(), _strides.end()),
    };
    // the device my cells live on
    const auto device = DLDevice { interop::deviceType(_strategy), 0 };
    // and the type of my cells
    const auto dtype = interop::dataType(_format);
    // a consumer that predates versioning
    if (!versioned) {
        // gets a legacy tensor
        auto * tensor = new DLManagedTensor {};
        // that describes my cells
        interop::describe(tensor->dl_tensor, _data, device, dtype, *exported);
        // holds on to what keeps them alive
        tensor->manager_ctx = exported;
        // and knows how to let go
        tensor->deleter = interop::releaseLegacy;
        // in a capsule named the way the legacy protocol names it
        return py::capsule(tensor, "dltensor", interop::destroyLegacy);
    }
    // everybody else gets a versioned tensor
    auto * tensor = new DLManagedTensorVersioned {};
    // stamped with the version of the protocol i speak
    tensor->version = { dlpackMajor, dlpackMinor };
    // that describes my cells
    interop::describe(tensor->dl_tensor, _data, device, dtype, *exported);
    // says whether they may be written
    tensor->flags = _writable ? 0 : dlpackReadOnly;
    // holds on to what keeps them alive
    tensor->manager_ctx = exported;
    // and knows how to let go
    tensor->deleter = interop::releaseVersioned;
    // in a capsule named the way the protocol names it
    return py::capsule(tensor, "dltensor_versioned", interop::destroyVersioned);
}


// the version 3 cuda array interface description of my cells
inline auto
pyre::py::grid::AnyGrid::cudaArrayInterface() const -> py::dict
{
    // the interface promises memory the device can reach, which host storage is not
    if (interop::deviceType(_strategy) == kDLCPU) {
        // so its absence is an attribute error, which is how consumers ask for it
        throw py::attribute_error(
            "a grid on '" + _strategy + "' storage has no cuda array interface");
    }
    // the interface measures strides in bytes
    py::tuple strides(_strides.size());
    // one axis at a time
    for (std::size_t axis = 0; axis < _strides.size(); ++axis) {
        // scale my stride by the width of a cell
        strides[axis] = _strides[axis] * static_cast<size_type>(_itemsize);
    }
    // make room for the description
    py::dict cai;
    // my extents
    cai["shape"] = py::tuple(py::cast(_shape));
    // the type of my cells
    cai["typestr"] = interop::typeString(_format);
    // my address, and whether my cells are read only
    cai["data"] = py::make_tuple(address(), !_writable);
    // my strides
    cai["strides"] = strides;
    // the version of the interface i speak
    cai["version"] = 3;
    // hand off the description
    return cai;
}


