// code guard
#pragma once


// support
#include "Index.h"


// default constructor: park the index at the origin
template <std::size_t Rank>
constexpr pyre::grid::Index<Rank>::Index() noexcept :
    // zero out every coordinate
    _coords {}
{}

// from a backing array
template <std::size_t Rank>
constexpr pyre::grid::Index<Rank>::Index(storage_type coords) noexcept :
    // take ownership of the caller's coordinates
    _coords { std::move(coords) }
{}

// the variadic constructor: spell out the coordinates one axis at a time
template <std::size_t Rank>
template <std::signed_integral... Ts>
    requires(sizeof...(Ts) == Rank)
constexpr pyre::grid::Index<Rank>::Index(Ts... xs) noexcept :
    // bring each argument into my coordinate type and lay them out in axis order
    _coords { static_cast<value_type>(xs)... }
{}

// initializer_list (debug length check)
template <std::size_t Rank>
constexpr pyre::grid::Index<Rank>::Index(std::initializer_list<value_type> ilist) noexcept
{
#if defined(DEBUG)
    // while developing, insist that the caller supply exactly one coordinate per axis
    assert(
        ilist.size() == Rank
        && "pyre::grid::Index: initializer_list length must equal the index rank");
#endif
    // make a counter
    size_type axis = 0;
    // go through the entries of the initializer list
    for (auto value : ilist) {
        // as long as there is an axis left to fill
        if (axis < Rank)
            // transfer the value to the next coordinate
            _coords[axis++] = value;
    }
}


// accessors
// my rank is baked in at compile time
template <std::size_t Rank>
consteval auto
pyre::grid::Index<Rank>::rank() noexcept -> size_type
{
    // easy enough
    return Rank;
}

// element access
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::operator[](size_type axis) noexcept -> reference
{
    // hand over the coordinate along {axis}, trusting the caller to stay in range
    return _coords[axis];
}

template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::operator[](size_type axis) const noexcept -> const_reference
{
    // hand over the coordinate along {axis} read-only
    return _coords[axis];
}


// bounds-checked element access
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::at(size_type axis) -> reference
{
    // let the backing array police the axis and complain if it is out of range
    return _coords.at(axis);
}

template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::at(size_type axis) const -> const_reference
{
    // same, read-only
    return _coords.at(axis);
}


// access to the underlying storage
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::data() noexcept -> pointer
{
    // expose the raw coordinates for code that wants a plain array
    return _coords.data();
}

template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::data() const noexcept -> const_pointer
{
    // same, read-only
    return _coords.data();
}


// interface
// the coordinate closest to negative infinity, over all axes
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::min() const noexcept -> value_type
{
    // scan every axis and report the smallest coordinate
    return *std::min_element(_coords.begin(), _coords.end());
}

// the coordinate furthest along, over all axes
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::max() const noexcept -> value_type
{
    // scan every axis and report the largest coordinate
    return *std::max_element(_coords.begin(), _coords.end());
}


// factories
// the index at the origin
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::zero() noexcept -> self_type
{
    // the default constructor already zeroes everything out
    return self_type {};
}

// the index one step along every axis
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::one() noexcept -> self_type
{
    // start at the origin
    self_type result;
    // and step once along each axis
    for (size_type axis = 0; axis < Rank; ++axis) {
        // by setting its coordinate to one
        result[axis] = 1;
    }
    // hand off the result
    return result;
}

// the index whose every coordinate is {value}
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::fill(value_type value) noexcept -> self_type
{
    // start at the origin
    self_type result;
    // and visit each axis
    for (size_type axis = 0; axis < Rank; ++axis) {
        // handing it the requested coordinate
        result[axis] = value;
    }
    // hand off the result
    return result;
}


// iteration support
// the first axis
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::begin() noexcept -> iterator
{
    // point at the coordinate of the first axis
    return _coords.begin();
}

// one past the last axis
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::end() noexcept -> iterator
{
    // point just beyond the last coordinate
    return _coords.end();
}

// the first axis, read-only
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::begin() const noexcept -> const_iterator
{
    // point at the coordinate of the first axis
    return _coords.begin();
}

// one past the last axis, read-only
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::end() const noexcept -> const_iterator
{
    // point just beyond the last coordinate
    return _coords.end();
}

// the first axis, read-only regardless of my constness
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::cbegin() const noexcept -> const_iterator
{
    // point at the coordinate of the first axis
    return _coords.cbegin();
}

// one past the last axis, read-only regardless of my constness
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::cend() const noexcept -> const_iterator
{
    // point just beyond the last coordinate
    return _coords.cend();
}


// reverse iteration support
// the last axis
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::rbegin() noexcept -> reverse_iterator
{
    // point at the coordinate of the last axis
    return _coords.rbegin();
}

// one before the first axis
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::rend() noexcept -> reverse_iterator
{
    // point just ahead of the first coordinate
    return _coords.rend();
}

// the last axis, read-only
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::rbegin() const noexcept -> const_reverse_iterator
{
    // point at the coordinate of the last axis
    return _coords.rbegin();
}

// one before the first axis, read-only
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::rend() const noexcept -> const_reverse_iterator
{
    // point just ahead of the first coordinate
    return _coords.rend();
}

// the last axis, read-only regardless of my constness
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::crbegin() const noexcept -> const_reverse_iterator
{
    // point at the coordinate of the last axis
    return _coords.crbegin();
}

// one before the first axis, read-only regardless of my constness
template <std::size_t Rank>
constexpr auto
pyre::grid::Index<Rank>::crend() const noexcept -> const_reverse_iterator
{
    // point just ahead of the first coordinate
    return _coords.crend();
}


// operators

// inject a representation of the index into a stream
template <std::size_t Rank>
auto
pyre::grid::operator<<(ostream_reference stream, const Index<Rank> & index) -> ostream_reference
{
    // the first coordinate needs no separator ahead of it
    const char * sep = "";
    // go through my coordinates in axis order
    for (const auto & coord : index) {
        // and render each one behind its separator
        stream << sep << coord;
        // from here on, coordinates are comma delimited
        sep = ", ";
    }
    // return the stream so injections can be chained
    return stream;
}


// two indices are equal when they agree at every axis
template <std::size_t Rank>
constexpr auto
pyre::grid::operator==(const Index<Rank> & i1, const Index<Rank> & i2) noexcept -> bool
{
    // compare the two indices axis by axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // the first disagreement settles the question
        if (i1[axis] != i2[axis]) {
            // they are not the same index
            return false;
        }
    }
    // no axis objected, so they name the same cell
    return true;
}


// add two indices component-wise
template <std::size_t Rank>
constexpr auto
pyre::grid::operator+(const Index<Rank> & i1, const Index<Rank> & i2) noexcept -> Index<Rank>
{
    // room for the answer
    Index<Rank> result;
    // fold in the contribution of each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // by adding the two coordinates there
        result[axis] = i1[axis] + i2[axis];
    }
    // hand off the result
    return result;
}


// subtract two indices component-wise
template <std::size_t Rank>
constexpr auto
pyre::grid::operator-(const Index<Rank> & i1, const Index<Rank> & i2) noexcept -> Index<Rank>
{
    // room for the answer
    Index<Rank> result;
    // fold in the contribution of each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // by measuring the displacement from {i2} to {i1} there
        result[axis] = i1[axis] - i2[axis];
    }
    // hand off the result
    return result;
}


// unary plus: an exact copy
template <std::size_t Rank>
constexpr auto
pyre::grid::operator+(const Index<Rank> & index) noexcept -> Index<Rank>
{
    // there is nothing to do but agree
    return index;
}

// unary minus: negate every coordinate
template <std::size_t Rank>
constexpr auto
pyre::grid::operator-(const Index<Rank> & index) noexcept -> Index<Rank>
{
    // room for the answer
    Index<Rank> result;
    // visit each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and reflect its coordinate through the origin
        result[axis] = -index[axis];
    }
    // hand off the result
    return result;
}


// scale an index by an {int}
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(const Index<Rank> & index, int scale) noexcept -> Index<Rank>
{
    // room for the answer
    Index<Rank> result;
    // visit each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and stretch its coordinate by {scale}
        result[axis] = scale * index[axis];
    }
    // hand off the result
    return result;
}

// multiplication commutes
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(int scale, const Index<Rank> & index) noexcept -> Index<Rank>
{
    // so let the other spelling do the work
    return index * scale;
}


// scale an index by a {long}
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(const Index<Rank> & index, long scale) noexcept -> Index<Rank>
{
    // room for the answer
    Index<Rank> result;
    // visit each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and stretch its coordinate by {scale}, in my own coordinate type
        result[axis] = static_cast<typename Index<Rank>::value_type>(scale) * index[axis];
    }
    // hand off the result
    return result;
}

// multiplication commutes
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(long scale, const Index<Rank> & index) noexcept -> Index<Rank>
{
    // so let the other spelling do the work
    return index * scale;
}


// divide an index by an {int}
template <std::size_t Rank>
constexpr auto
pyre::grid::operator/(const Index<Rank> & index, int scale) noexcept -> Index<Rank>
{
    // room for the answer
    Index<Rank> result;
    // visit each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and shrink its coordinate by {scale}, truncating towards zero
        result[axis] = index[axis] / scale;
    }
    // hand off the result
    return result;
}

// divide an index by a {long}
template <std::size_t Rank>
constexpr auto
pyre::grid::operator/(const Index<Rank> & index, long scale) noexcept -> Index<Rank>
{
    // room for the answer
    Index<Rank> result;
    // visit each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and shrink its coordinate by {scale}, in my own coordinate type
        result[axis] = index[axis] / static_cast<typename Index<Rank>::value_type>(scale);
    }
    // hand off the result
    return result;
}


// scale an index by a {double}, promoting the result to reals
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(const Index<Rank> & index, double scale) noexcept -> doubles_t<Rank>
{
    // room for the answer, which no longer lands on grid cells
    doubles_t<Rank> result;
    // visit each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and stretch its coordinate in the reals
        result[axis] = scale * static_cast<double>(index[axis]);
    }
    // hand off the result
    return result;
}

// multiplication commutes
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(double scale, const Index<Rank> & index) noexcept -> doubles_t<Rank>
{
    // so let the other spelling do the work
    return index * scale;
}

// divide an index by a {double}, promoting the result to reals
template <std::size_t Rank>
constexpr auto
pyre::grid::operator/(const Index<Rank> & index, double scale) noexcept -> doubles_t<Rank>
{
    // room for the answer, which no longer lands on grid cells
    doubles_t<Rank> result;
    // visit each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and shrink its coordinate in the reals
        result[axis] = static_cast<double>(index[axis]) / scale;
    }
    // hand off the result
    return result;
}


// scale an index by a {float}, promoting the result to reals
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(const Index<Rank> & index, float scale) noexcept -> floats_t<Rank>
{
    // room for the answer, which no longer lands on grid cells
    floats_t<Rank> result;
    // visit each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and stretch its coordinate in the reals
        result[axis] = scale * static_cast<float>(index[axis]);
    }
    // hand off the result
    return result;
}

// multiplication commutes
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(float scale, const Index<Rank> & index) noexcept -> floats_t<Rank>
{
    // so let the other spelling do the work
    return index * scale;
}

// divide an index by a {float}, promoting the result to reals
template <std::size_t Rank>
constexpr auto
pyre::grid::operator/(const Index<Rank> & index, float scale) noexcept -> floats_t<Rank>
{
    // room for the answer, which no longer lands on grid cells
    floats_t<Rank> result;
    // visit each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and shrink its coordinate in the reals
        result[axis] = static_cast<float>(index[axis]) / scale;
    }
    // hand off the result
    return result;
}


// shift an index forward by a shape
template <std::size_t Rank>
constexpr auto
pyre::grid::operator+(const Index<Rank> & index, const Shape<Rank> & shape) noexcept -> Index<Rank>
{
    // room for the answer
    Index<Rank> result;
    // visit each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and step its coordinate up by the extent there, in signed arithmetic
        result[axis] = index[axis] + static_cast<typename Index<Rank>::value_type>(shape[axis]);
    }
    // hand off the result
    return result;
}


// shift an index backward by a shape
template <std::size_t Rank>
constexpr auto
pyre::grid::operator-(const Index<Rank> & index, const Shape<Rank> & shape) noexcept -> Index<Rank>
{
    // room for the answer
    Index<Rank> result;
    // visit each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and step its coordinate down by the extent there, in signed arithmetic
        result[axis] = index[axis] - static_cast<typename Index<Rank>::value_type>(shape[axis]);
    }
    // hand off the result
    return result;
}


// cartesian product: concatenate {i1} and {i2} into an index of rank {Rank1+Rank2}
template <std::size_t Rank1, std::size_t Rank2>
constexpr auto
pyre::grid::operator*(const Index<Rank1> & i1, const Index<Rank2> & i2) noexcept
    -> Index<Rank1 + Rank2>
{
    // room for the widened answer
    Index<Rank1 + Rank2> result;
    // the leading axes come from {i1}
    for (std::size_t axis = 0; axis < Rank1; ++axis) {
        // copied over verbatim
        result[axis] = i1[axis];
    }
    // the trailing axes come from {i2}
    for (std::size_t axis = 0; axis < Rank2; ++axis) {
        // laid down just past the axes of {i1}
        result[Rank1 + axis] = i2[axis];
    }
    // hand off the result
    return result;
}


// structured binding support

// the number of components of an {Index<Rank>} is {Rank}
template <std::size_t Rank>
struct std::tuple_size<pyre::grid::Index<Rank>> : std::integral_constant<std::size_t, Rank> {};

// each component is a {value_type}
template <std::size_t I, std::size_t Rank>
struct std::tuple_element<I, pyre::grid::Index<Rank>> {
    // every axis carries a coordinate, no matter which one is being unpacked
    using type = typename pyre::grid::Index<Rank>::value_type;
};

// for a const index, each component is a {const value_type}
template <std::size_t I, std::size_t Rank>
struct std::tuple_element<I, const pyre::grid::Index<Rank>> {
    // constness of the index carries over to the unpacked coordinates
    using type = const typename pyre::grid::Index<Rank>::value_type;
};


// get the {I}-th coordinate by reference
template <std::size_t I, std::size_t Rank>
constexpr auto
pyre::grid::get(Index<Rank> & index) noexcept -> typename Index<Rank>::reference
{
    // bind to the coordinate so the caller can write through it
    return index[I];
}

// get the {I}-th coordinate from a temporary
template <std::size_t I, std::size_t Rank>
constexpr auto
pyre::grid::get(Index<Rank> && index) noexcept -> typename Index<Rank>::rvalue_reference
{
    // the index is expiring, so let the coordinate be moved out of it
    return std::move(index[I]);
}

// get the {I}-th coordinate read-only
template <std::size_t I, std::size_t Rank>
constexpr auto
pyre::grid::get(const Index<Rank> & index) noexcept -> typename Index<Rank>::const_reference
{
    // bind to the coordinate, but deny write access
    return index[I];
}

// get the {I}-th coordinate read-only from a const temporary
template <std::size_t I, std::size_t Rank>
constexpr auto
pyre::grid::get(const Index<Rank> && index) noexcept -> typename Index<Rank>::const_rvalue_reference
{
    // the index is expiring, but its constness still forbids stealing the coordinate
    return std::move(index[I]);
}


