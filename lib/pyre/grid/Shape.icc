// code guard
#pragma once


// support
#include "Shape.h"


// default constructor: a degenerate shape whose every axis has zero extent
template <std::size_t Rank>
constexpr pyre::grid::Shape<Rank>::Shape() noexcept :
    // start out with nothing addressable along any axis
    _extents {}
{}

// from a backing array
template <std::size_t Rank>
constexpr pyre::grid::Shape<Rank>::Shape(storage_type extents) noexcept :
    // take ownership of the caller's table of extents
    _extents { std::move(extents) }
{}

// the variadic constructor: one extent per axis, spelled out
template <std::size_t Rank>
template <std::integral... Ts>
    requires(sizeof...(Ts) == Rank)
constexpr pyre::grid::Shape<Rank>::Shape(Ts... xs) noexcept :
    // normalize the arguments to my cell type and lay them out in axis order
    _extents { static_cast<value_type>(xs)... }
{}

// initializer_list: the brace enclosed spelling, with a debug time length check
template <std::size_t Rank>
constexpr pyre::grid::Shape<Rank>::Shape(std::initializer_list<value_type> ilist) noexcept
{
#if defined(DEBUG)
    // while developing, insist that the caller supply exactly one extent per axis
    assert(
        ilist.size() == Rank
        && "pyre::grid::Shape: initializer_list length must equal the shape rank");
#endif
    // start filling at the leading axis
    size_type axis = 0;
    // go through the entries of the initializer list
    for (auto value : ilist) {
        // as long as there no overflow
        if (axis < Rank)
            // transfer the value to the next index
            _extents[axis++] = value;
    }
    // all done
    return;
}


// accessors
// my rank is a property of my type, so it is known to the compiler
template <std::size_t Rank>
consteval auto
pyre::grid::Shape<Rank>::rank() noexcept -> size_type
{
    // easy enough
    return Rank;
}

// element access: hand out the extent of a given axis, without checking that it exists
template <std::size_t Rank>
constexpr auto
pyre::grid::Shape<Rank>::operator[](size_type axis) noexcept -> reference
{
    // easy enough
    return _extents[axis];
}

// the read-only flavor
template <std::size_t Rank>
constexpr auto
pyre::grid::Shape<Rank>::operator[](size_type axis) const noexcept -> const_reference
{
    // easy enough
    return _extents[axis];
}


// bounds-checked element access; complains about axes that don't exist
template <std::size_t Rank>
constexpr auto
pyre::grid::Shape<Rank>::at(size_type axis) -> reference
{
    // delegate to the backing array
    return _extents.at(axis);
}

// the read-only flavor
template <std::size_t Rank>
constexpr auto
pyre::grid::Shape<Rank>::at(size_type axis) const -> const_reference
{
    // delegate to the backing array
    return _extents.at(axis);
}


// access to the underlying storage, for clients that must talk to raw memory
template <std::size_t Rank>
constexpr auto
pyre::grid::Shape<Rank>::data() noexcept -> pointer
{
    // easy enough
    return _extents.data();
}

// the read-only flavor
template <std::size_t Rank>
constexpr auto
pyre::grid::Shape<Rank>::data() const noexcept -> const_pointer
{
    // easy enough
    return _extents.data();
}


// interface
// the number of cells i address is the product of my extents
template <std::size_t Rank>
constexpr auto
pyre::grid::Shape<Rank>::cells() const noexcept -> value_type
{
    // the empty product is unity, so a rank zero shape addresses a single cell
    size_type cells = 1;
    // go through the extents
    for (size_type axis = 0; axis < Rank; ++axis) {
        // fold the contribution of each one
        cells *= _extents[axis];
    }
    // all done
    return cells;
}


// the smallest extent, i.e. the length of my shortest axis
template <std::size_t Rank>
constexpr auto
pyre::grid::Shape<Rank>::min() const noexcept -> value_type
{
    // scan the extents
    return *std::min_element(_extents.begin(), _extents.end());
}

// the largest extent, i.e. the length of my longest axis
template <std::size_t Rank>
constexpr auto
pyre::grid::Shape<Rank>::max() const noexcept -> value_type
{
    // scan the extents
    return *std::max_element(_extents.begin(), _extents.end());
}


// factories
// make a shape with all extents zeroed out; it addresses nothing at all
template <std::size_t Rank>
constexpr auto
pyre::grid::Shape<Rank>::zero() noexcept -> self_type
{
    // default construction zero-initializes the backing array
    return self_type {};
}


// make a shape with all extents set to one; it addresses exactly one cell
template <std::size_t Rank>
constexpr auto
pyre::grid::Shape<Rank>::one() noexcept -> self_type
{
    // make a shape
    self_type result;
    // set each extent
    for (size_type axis = 0; axis < Rank; ++axis) {
        // to unity
        result[axis] = 1;
    }
    // all done
    return result;
}


// make a cube: every axis gets the same extent
template <std::size_t Rank>
constexpr auto
pyre::grid::Shape<Rank>::fill(value_type value) noexcept -> self_type
{
    // make a shape
    self_type result;
    // fill each extent
    for (size_type axis = 0; axis < Rank; ++axis) {
        // with the requested value
        result[axis] = value;
    }
    // all done
    return result;
}


// iteration support
// point at the extent of the leading axis
template <std::size_t Rank>
constexpr auto
pyre::grid::Shape<Rank>::begin() noexcept -> iterator
{
    // easy enough
    return _extents.begin();
}

