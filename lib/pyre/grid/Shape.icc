// operators

// inject a representation of the shape into a stream
template <std::size_t Rank>
auto
pyre::grid::operator<<(ostream_reference stream, const Shape<Rank> & shape) -> ostream_reference
{
    // start without a separator
    const char * sep = "";
    // go through the extents
    for (const auto & extent : shape) {
        // inject this extent
        stream << sep << extent;
        // place a separator before the next one
        sep = ", ";
    }
    // all done
    return stream;
}


// two shapes are equal when they agree at every axis
template <std::size_t Rank>
constexpr auto
pyre::grid::operator==(const Shape<Rank> & s1, const Shape<Rank> & s2) noexcept -> bool
{
    // check each axis
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // if there is a mismatch
        if (s1[axis] != s2[axis]) {
            // the shapes are not equal
            return false;
        }
    }
    // all axes matched
    return true;
}


// add two shapes component-wise, growing each axis by the matching extent of {s2}
template <std::size_t Rank>
constexpr auto
pyre::grid::operator+(const Shape<Rank> & s1, const Shape<Rank> & s2) noexcept -> Shape<Rank>
{
    // make room for the result
    Shape<Rank> result;
    // go through the axes
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and accumulate the sum
        result[axis] = s1[axis] + s2[axis];
    }
    // all done
    return result;
}


// subtract two shapes component-wise, shrinking each axis by the matching extent of {s2}
// extents are signed, so a difference that goes below zero says so rather than wrapping
template <std::size_t Rank>
constexpr auto
pyre::grid::operator-(const Shape<Rank> & s1, const Shape<Rank> & s2) noexcept -> Shape<Rank>
{
    // make room for the result
    Shape<Rank> result;
    // go through the axes
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and compute the difference
        result[axis] = s1[axis] - s2[axis];
    }
    // all done
    return result;
}


// unary plus: an exact copy
template <std::size_t Rank>
constexpr auto
pyre::grid::operator+(const Shape<Rank> & shape) noexcept -> Shape<Rank>
{
    // nothing to do
    return shape;
}

// unary minus: negate every extent; note the modular arithmetic of the unsigned {value_type}
template <std::size_t Rank>
constexpr auto
pyre::grid::operator-(const Shape<Rank> & shape) noexcept -> Shape<Rank>
{
    // make room for the result
    Shape<Rank> result;
    // go through the axes
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and negate each extent
        result[axis] = -shape[axis];
    }
    // all done
    return result;
}


// scale a shape by an {int}: stretch every axis by the same integral factor
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(const Shape<Rank> & shape, int scale) noexcept -> Shape<Rank>
{
    // make room for the result
    Shape<Rank> result;
    // go through the axes
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and scale each extent
        result[axis] = static_cast<typename Shape<Rank>::value_type>(scale) * shape[axis];
    }
    // all done
    return result;
}

// multiplication commutes
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(int scale, const Shape<Rank> & shape) noexcept -> Shape<Rank>
{
    // invoke the reference implementation
    return shape * scale;
}


// scale a shape by a {long}: same stretch, with room for larger factors
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(const Shape<Rank> & shape, long scale) noexcept -> Shape<Rank>
{
    // make room for the result
    Shape<Rank> result;
    // go through the axes
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and scale each extent
        result[axis] = static_cast<typename Shape<Rank>::value_type>(scale) * shape[axis];
    }
    // all done
    return result;
}

// multiplication commutes
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(long scale, const Shape<Rank> & shape) noexcept -> Shape<Rank>
{
    // invoke the  reference implementation
    return shape * scale;
}


// divide a shape by an {int}: shrink every axis, truncating towards zero
template <std::size_t Rank>
constexpr auto
pyre::grid::operator/(const Shape<Rank> & shape, int scale) noexcept -> Shape<Rank>
{
    // make room for the result
    Shape<Rank> result;
    // go through the axes
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and scale each extent
        result[axis] = shape[axis] / static_cast<typename Shape<Rank>::value_type>(scale);
    }
    // all done
    return result;
}

// divide a shape by a {long}: same shrink, with room for larger divisors
template <std::size_t Rank>
constexpr auto
pyre::grid::operator/(const Shape<Rank> & shape, long scale) noexcept -> Shape<Rank>
{
    // make room for the result
    Shape<Rank> result;
    // go through the axes
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and scale each extent
        result[axis] = shape[axis] / static_cast<typename Shape<Rank>::value_type>(scale);
    }
    // all done
    return result;
}


// scale a shape by a {double}, promoting the result to reals
// the answer is no longer a cell count, so it comes back as a tuple of reals
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(const Shape<Rank> & shape, double scale) noexcept -> doubles_t<Rank>
{
    // make room for the result
    doubles_t<Rank> result;
    // go through the axes
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and scale each extent
        result[axis] = scale * static_cast<double>(shape[axis]);
    }
    // all done
    return result;
}

// multiplication commutes
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(double scale, const Shape<Rank> & shape) noexcept -> doubles_t<Rank>
{
    // invoke the reference implementation
    return shape * scale;
}

// divide a shape by a {double}, promoting the result to reals
template <std::size_t Rank>
constexpr auto
pyre::grid::operator/(const Shape<Rank> & shape, double scale) noexcept -> doubles_t<Rank>
{
    // make room for the result
    doubles_t<Rank> result;
    // go through the axes
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and scale each extent
        result[axis] = static_cast<double>(shape[axis]) / scale;
    }
    // all done
    return result;
}


// scale a shape by a {float}, promoting the result to reals
// same idea as the {double} case, at single precision
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(const Shape<Rank> & shape, float scale) noexcept -> floats_t<Rank>
{
    // make room for the result
    floats_t<Rank> result;
    // go through the axes
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and scale each extent
        result[axis] = scale * static_cast<float>(shape[axis]);
    }
    // all done
    return result;
}

// multiplication commutes
template <std::size_t Rank>
constexpr auto
pyre::grid::operator*(float scale, const Shape<Rank> & shape) noexcept -> floats_t<Rank>
{
    // invoke the reference implementation
    return shape * scale;
}

// divide a shape by a {float}, promoting the result to reals
template <std::size_t Rank>
constexpr auto
pyre::grid::operator/(const Shape<Rank> & shape, float scale) noexcept -> floats_t<Rank>
{
    // make room for the result
    floats_t<Rank> result;
    // go through the axes
    for (std::size_t axis = 0; axis < Rank; ++axis) {
        // and scale each extent
        result[axis] = static_cast<float>(shape[axis]) / scale;
    }
    // all done
    return result;
}


// cartesian product: concatenate {s1} and {s2} into a shape of rank {Rank1+Rank2}
// the resulting grid addresses the product of the two cell counts
template <std::size_t Rank1, std::size_t Rank2>
constexpr auto
pyre::grid::operator*(const Shape<Rank1> & s1, const Shape<Rank2> & s2) noexcept
    -> Shape<Rank1 + Rank2>
{
    // make room for the result
    Shape<Rank1 + Rank2> result;
    // place {s1}'s extents
    for (std::size_t axis = 0; axis < Rank1; ++axis) {
        // in the first {Rank1} slots
        result[axis] = s1[axis];
    }
    // follow with {s2}'s extents
    for (std::size_t axis = 0; axis < Rank2; ++axis) {
        // in the remaining ranks
        result[Rank1 + axis] = s2[axis];
    }
    // all done
    return result;
}


// structured binding support
// these three specializations let clients say {auto [rows, cols] = shape}

// the number of components of a {Shape<Rank>} is {Rank}
template <std::size_t Rank>
struct std::tuple_size<pyre::grid::Shape<Rank>> : std::integral_constant<std::size_t, Rank> {};

// each component is a {value_type}
template <std::size_t I, std::size_t Rank>
struct std::tuple_element<I, pyre::grid::Shape<Rank>> {
    // every slot holds an extent
    using type = typename pyre::grid::Shape<Rank>::value_type;
};

// for a const shape, each component is a {const value_type}
template <std::size_t I, std::size_t Rank>
struct std::tuple_element<I, const pyre::grid::Shape<Rank>> {
    // constness of the shape propagates to the bound names
    using type = const typename pyre::grid::Shape<Rank>::value_type;
};


// get the {I}-th extent by reference, so the binding can be written through
template <std::size_t I, std::size_t Rank>
constexpr auto
pyre::grid::get(Shape<Rank> & shape) noexcept -> typename Shape<Rank>::reference
{
    // the axis is a compile time constant, so no check is necessary
    return shape[I];
}

// get the {I}-th extent from a temporary, preserving its ability to be moved from
template <std::size_t I, std::size_t Rank>
constexpr auto
pyre::grid::get(Shape<Rank> && shape) noexcept -> typename Shape<Rank>::rvalue_reference
{
    // hand back the extent with the value category of its owner
    return std::move(shape[I]);
}

// get the {I}-th extent read-only
template <std::size_t I, std::size_t Rank>
constexpr auto
pyre::grid::get(const Shape<Rank> & shape) noexcept -> typename Shape<Rank>::const_reference
{
    // the axis is a compile time constant, so no check is necessary
    return shape[I];
}

// get the {I}-th extent read-only from a const temporary
template <std::size_t I, std::size_t Rank>
constexpr auto
pyre::grid::get(const Shape<Rank> && shape) noexcept -> typename Shape<Rank>::const_rvalue_reference
{
    // hand back the extent with the value category of its owner
    return std::move(shape[I]);
}


