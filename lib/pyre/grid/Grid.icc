// code guard
#pragma once

// support
#include "Grid.h"


// metamethods - constructors
// construct from fully-formed policies
template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
constexpr pyre::grid::Grid<P, S>::Grid(packing_type packing, storage_type storage) :
    // adopt the two strategies the caller handed over, without copying them again
    _packing(std::move(packing)),
    _storage(std::move(storage))
{}

// in-place construction of the policies
template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
template <class... PArgs, class... SArgs>
    requires(pyre::grid::concepts::PackingConstructible<P, PArgs...>
             && pyre::grid::concepts::StorageConstructible<S, SArgs...>)
constexpr pyre::grid::Grid<P, S>::Grid(
    std::piecewise_construct_t, std::tuple<PArgs...> pArgs, std::tuple<SArgs...> sArgs) :
    // spread each argument pack over the matching strategy constructor, building both in place
    _packing(std::make_from_tuple<packing_type>(std::move(pArgs))),
    _storage(std::make_from_tuple<storage_type>(std::move(sArgs)))
{}

// accessors
template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
[[nodiscard]] constexpr auto
pyre::grid::Grid<P, S>::packing() const noexcept -> const packing_type &
{
    // let clients inspect my addressing scheme, but not disturb it
    return _packing;
}

template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
[[nodiscard]] constexpr auto
pyre::grid::Grid<P, S>::storage() const noexcept -> const storage_type &
{
    // let clients inspect where my cells live, but not disturb it
    return _storage;
}

// the address of my first cell
template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
[[nodiscard]] constexpr auto
pyre::grid::Grid<P, S>::data() const noexcept
    requires concepts::ContiguousStorage<storage_type>
{
    // ask my storage for the start of its block
    return _storage.data();
}


// interface - reaching a cell

// the cell named by an index, trusting the caller
template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
[[nodiscard]] constexpr auto
pyre::grid::Grid<P, S>::operator[](const index_type & idx) const -> reference
{
    // ask my packing where this index lives, and hand back whatever cell is there
    return (*this)[_packing.offset(idx)];
}

// the cell at a given offset, trusting the caller
template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
[[nodiscard]] constexpr auto
pyre::grid::Grid<P, S>::operator[](difference_type off) const -> reference
{
    // my storage measures displacements the same way my packing does, so the offset travels
    // across unchanged; an offset that came out negative stays negative, and on this path it is
    // the caller who promised it would not
    return _storage[off];
}

// the cell named by an index, guarded
template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
[[nodiscard]] constexpr auto
pyre::grid::Grid<P, S>::at(const index_type & idx) const -> reference
{
    // ask my packing where this index lives, and reach for that cell with the guard on
    return at(_packing.offset(idx));
}

// the cell at a given offset, guarded
template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
[[nodiscard]] constexpr auto
pyre::grid::Grid<P, S>::at(difference_type off) const -> reference
{
    // let the storage do the checking and the complaining; it measures displacements the way my
    // packing does, so a negative offset arrives as a negative number and can be reported as one
    return _storage.at(off);
}


// interface - sub-grids

// the sub-grid anchored at {base} with extent {tile}
template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
[[nodiscard]] constexpr auto
pyre::grid::Grid<P, S>::box(index_type base, shape_type tile) const -> self_type
    requires requires(const packing_type p, index_type i, shape_type s) { p.box(i, s); }
{
    // let my packing work out the sub-layout, and pair it with my own cells; the derived layout
    // keeps my strides, so the sub-grid reads and writes the very cells i do
    return self_type { _packing.box(base, tile), _storage };
}

// the lower rank grid left behind when the axes outside {FreeAxes} are pinned at {base}
template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
template <std::size_t... FreeAxes>
[[nodiscard]] constexpr auto
pyre::grid::Grid<P, S>::slice(const index_type & base) const
{
    // ask my packing for the hyperplane
    auto sliced = _packing.template slice<FreeAxes...>(base);
    // and pair it with my cells; the slice inherits my strides, so it too addresses my memory
    return Grid<decltype(sliced), storage_type> { sliced, _storage };
}


// interface - iteration

// a cursor parked on my first cell
template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
[[nodiscard]] constexpr auto
pyre::grid::Grid<P, S>::begin() const -> iterator
{
    // ride the index cursor my packing hands out, over my own cells
    return iterator { *this, _packing.begin() };
}

// a cursor that skips ahead by {step} along each axis
template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
[[nodiscard]] constexpr auto
pyre::grid::Grid<P, S>::begin(const index_type & step) const -> iterator
{
    // same, but let the packing know how far to move on each advance
    return iterator { *this, _packing.begin(step) };
}

// the cursor that marks the end of the sweep
template <pyre::grid::concepts::PackingStrategy P, pyre::grid::concepts::StorageStrategy S>
[[nodiscard]] constexpr auto
pyre::grid::Grid<P, S>::end() const -> iterator
{
    // the sweep is over when the index cursor says it is
    return iterator { *this, _packing.end() };
}


// end of file
