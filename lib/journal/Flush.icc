// code guard
#pragma once


// my declarations
#include "Flush.h"


// metamethods
template <typename decoratorT>
pyre::journal::Flush<decoratorT>::Flush(decorator_type decorator) : _decorator(decorator)
{}


// interface
// accessors
template <typename decoratorT>
auto
pyre::journal::Flush<decoratorT>::decorator() const -> const decorator_type &
{
    // easy enough
    return _decorator;
}


