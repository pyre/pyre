// code guard
#pragma once


// my declarations
#include "Courier.h"


// accessors
// the descriptor
auto
pyre::journal::Courier::descriptor() const -> descriptor_type
{
    // easy enough
    return _descriptor;
}


// the device that also gets every entry
auto
pyre::journal::Courier::mirror() const -> mirror_type
{
    // easy enough
    return _mirror;
}


// replace the device that also gets every entry
auto
pyre::journal::Courier::mirror(mirror_type mirror) -> Courier &
{
    // install the new mirror
    _mirror = std::move(mirror);
    // and enable chaining
    return *this;
}


// the sequence number of the last record stamped
auto
pyre::journal::Courier::seq() const -> count_type
{
    // easy enough
    return _seq;
}


// the number of records that made it out
auto
pyre::journal::Courier::shipped() const -> count_type
{
    // easy enough
    return _shipped;
}


// the number of records lost since the last successful write
auto
pyre::journal::Courier::dropped() const -> count_type
{
    // easy enough
    return _dropped;
}


// whether the far end has gone away
auto
pyre::journal::Courier::dead() const -> bool
{
    // easy enough
    return _dead;
}


// end of file
