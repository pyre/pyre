// code guard
#pragma once


// my declarations
#include "Communicator.h"

// the exceptions i raise, which must be complete before i can throw them
#include "Error.h"
// the vocabulary my messages are phrased in
#include "datatypes.h"
#include "ops.h"


// metamethods
// adopt an existing handle
pyre::mpi::Communicator::Communicator(handle_type handle, bool immortal) : _handle(handle, immortal)
{}


// structure
// the raw token, for handing to the mpi c api
auto
pyre::mpi::Communicator::handle() const -> handle_type
{
    // ask my owner
    return _handle.handle();
}


// whether i name no communicator at all
auto
pyre::mpi::Communicator::isNull() const -> bool
{
    // compare against the token mpi reserves for exactly this
    return handle() == MPI_COMM_NULL;
}


// contextual conversion to {bool}
pyre::mpi::Communicator::
operator bool() const
{
    // i am usable exactly when i name a communicator
    return !isNull();
}


// the rank of the calling process within me
auto
pyre::mpi::Communicator::rank() const -> rank_t
{
    // room for the answer
    rank_t rank = 0;
    // ask mpi
    check(MPI_Comm_rank(handle(), &rank));
    // hand it off
    return rank;
}


// how many processes i hold
auto
pyre::mpi::Communicator::size() const -> size_type
{
    // room for the answer
    size_type size = 0;
    // ask mpi
    check(MPI_Comm_size(handle(), &size));
    // hand it off
    return size;
}


// the set of processes i hold
auto
pyre::mpi::Communicator::group() const -> group_type
{
    // room for the new token
    group_type::handle_type group = MPI_GROUP_NULL;
    // ask mpi to build it
    check(MPI_Comm_group(handle(), &group));
    // wrap it and hand it off
    return group_type(group);
}


// how my membership and context relate to {other}'s
auto
pyre::mpi::Communicator::compare(const Communicator & other) const -> Comparison
{
    // room for the answer
    int result = MPI_UNEQUAL;
    // ask mpi
    check(MPI_Comm_compare(handle(), other.handle(), &result));
    // translate its answer into one of my labels
    return comparison(result);
}


// communicator factories
// build the communicator that holds exactly the processes of {group}
auto
pyre::mpi::Communicator::communicator(const group_type & group) const -> Communicator
{
    // room for the new token
    handle_type communicator = MPI_COMM_NULL;
    // ask mpi to build it; this is collective over me, so every one of my processes must call
    check(MPI_Comm_create(handle(), group.handle(), &communicator));
    // the processes that {group} left out get the null communicator back, which mpi predefines
    // and which is therefore not ours to release
    if (communicator == MPI_COMM_NULL) {
        return Communicator(communicator, true);
    }
    // everybody else owns a fresh communicator
    return Communicator(communicator);
}


// split me into one communicator per distinct {color}
auto
pyre::mpi::Communicator::split(int color, int key) const -> Communicator
{
    // room for the new token
    handle_type communicator = MPI_COMM_NULL;
    // ask mpi to build it; this is collective over me
    check(MPI_Comm_split(handle(), color, key, &communicator));
    // a process that passes {undefined} as its color asks to be left out, and gets the null
    // communicator back; mpi predefines that one, so it is not ours to release
    if (communicator == MPI_COMM_NULL) {
        return Communicator(communicator, true);
    }
    // everybody else owns a fresh communicator
    return Communicator(communicator);
}


// build a communicator with my membership but a fresh context
auto
pyre::mpi::Communicator::duplicate() const -> Communicator
{
    // room for the new token
    handle_type communicator = MPI_COMM_NULL;
    // ask mpi to build it; this is collective over me
    check(MPI_Comm_dup(handle(), &communicator));
    // wrap it and hand it off
    return Communicator(communicator);
}


// collective operations
// block until every one of my processes arrives here
auto
pyre::mpi::Communicator::barrier() const -> void
{
    // hand off to mpi
    check(MPI_Barrier(handle()));
    // all done
    return;
}


// send {value} from {root} to every one of my processes
template <typename cellT>
auto
pyre::mpi::Communicator::bcast(cellT & value, rank_t root) const -> void
{
    // one cell, whose layout we deduce
    check(MPI_Bcast(&value, 1, datatype<cellT>(), root, handle()));
    // all done
    return;
}


// the same, for a block of cells whose extent every process already agrees on
template <typename cellT>
auto
pyre::mpi::Communicator::bcast(std::vector<cellT> & values, rank_t root) const -> void
{
    // every process must already have sized its buffer to match {root}'s; if that is not so,
    // use the {bytes_t} overload, which carries the extent along with the payload
    check(MPI_Bcast(
        values.data(), static_cast<int>(values.size()), datatype<cellT>(), root, handle()));
    // all done
    return;
}


// the same, for a payload whose extent only {root} knows
auto
pyre::mpi::Communicator::bcast(bytes_t & payload, rank_t root) const -> void
{
    // {root} alone knows how many bytes there are, so tell everybody else first
    long long extent = (rank() == root) ? static_cast<long long>(payload.size()) : 0;
    // by broadcasting the extent
    check(MPI_Bcast(&extent, 1, MPI_LONG_LONG_INT, root, handle()));
    // now that everybody agrees, make room for what is coming; at {root} this is a no-op
    payload.resize(extent);
    // and move the payload itself
    check(MPI_Bcast(payload.data(), static_cast<int>(extent), MPI_BYTE, root, handle()));
    // all done
    return;
}


// combine the {value} of every process with {op}, delivering the answer to {root} alone
template <typename cellT>
auto
pyre::mpi::Communicator::reduce(const cellT & value, Op op, rank_t root) const -> cellT
{
    // room for the answer; mpi writes it at {root} only, so start from something well defined
    cellT answer {};
    // combine
    check(MPI_Reduce(&value, &answer, 1, datatype<cellT>(), opcode(op), root, handle()));
    // hand it off; everybody but {root} gets the value we started from
    return answer;
}


// the same, delivering the answer to every process
template <typename cellT>
auto
pyre::mpi::Communicator::allreduce(const cellT & value, Op op) const -> cellT
{
    // room for the answer
    cellT answer {};
    // combine, and hand the result to everybody
    check(MPI_Allreduce(&value, &answer, 1, datatype<cellT>(), opcode(op), handle()));
    // hand it off
    return answer;
}


// the same, combining the cells of {values} elementwise
template <typename cellT>
auto
pyre::mpi::Communicator::allreduce(const std::vector<cellT> & values, Op op) const
    -> std::vector<cellT>
{
    // room for the answer, one cell per cell we were handed
    std::vector<cellT> answer(values.size());
    // combine, and hand the result to everybody
    check(MPI_Allreduce(
        values.data(), answer.data(), static_cast<int>(values.size()), datatype<cellT>(),
        opcode(op), handle()));
    // hand it off
    return answer;
}


// deliver to each process the combination over all the processes that precede it, itself included
template <typename cellT>
auto
pyre::mpi::Communicator::scan(const cellT & value, Op op) const -> cellT
{
    // room for the answer
    cellT answer {};
    // combine
    check(MPI_Scan(&value, &answer, 1, datatype<cellT>(), opcode(op), handle()));
    // hand it off
    return answer;
}


// the same, itself excluded
template <typename cellT>
auto
pyre::mpi::Communicator::exscan(const cellT & value, Op op) const -> cellT
{
    // room for the answer; mpi leaves it untouched at rank zero, where there is nothing to
    // combine, so start from something well defined
    cellT answer {};
    // combine
    check(MPI_Exscan(&value, &answer, 1, datatype<cellT>(), opcode(op), handle()));
    // hand it off
    return answer;
}


// collect the {value} of every process at {root}, in rank order
template <typename cellT>
auto
pyre::mpi::Communicator::gather(const cellT & value, rank_t root) const -> std::vector<cellT>
{
    // whether this process is the one that collects
    bool collecting = (rank() == root);
    // only {root} needs room for the answer; everybody else hands mpi nothing
    std::vector<cellT> answer(collecting ? size() : 0);
    // collect
    check(MPI_Gather(
        &value, 1, datatype<cellT>(), collecting ? answer.data() : nullptr, 1, datatype<cellT>(),
        root, handle()));
    // hand it off; it is empty everywhere but {root}
    return answer;
}


// the same, delivering the answer to every process
template <typename cellT>
auto
pyre::mpi::Communicator::allgather(const cellT & value) const -> std::vector<cellT>
{
    // everybody needs room for one cell per process
    std::vector<cellT> answer(size());
    // collect, and hand the result to everybody
    check(
        MPI_Allgather(&value, 1, datatype<cellT>(), answer.data(), 1, datatype<cellT>(), handle()));
    // hand it off
    return answer;
}


// hand the nth cell of {values} to the nth process
template <typename cellT>
auto
pyre::mpi::Communicator::scatter(const std::vector<cellT> & values, rank_t root) const -> cellT
{
    // whether this process is the one that hands the cells out
    bool distributing = (rank() == root);
    // {root} must have brought exactly one cell per process; nobody else's {values} matters
    if (distributing && values.size() != static_cast<std::size_t>(size())) {
        // so refuse, rather than let mpi read past the end of the buffer
        throw ShapeError("pyre::mpi::scatter: the root must supply one cell per process");
    }
    // room for my share
    cellT answer {};
    // hand them out
    check(MPI_Scatter(
        distributing ? values.data() : nullptr, 1, datatype<cellT>(), &answer, 1, datatype<cellT>(),
        root, handle()));
    // hand it off
    return answer;
}


// hand the nth cell of every process's {values} to the nth process
template <typename cellT>
auto
pyre::mpi::Communicator::alltoall(const std::vector<cellT> & values) const -> std::vector<cellT>
{
    // every process must have brought exactly one cell per process
    if (values.size() != static_cast<std::size_t>(size())) {
        // so refuse, rather than let mpi read past the end of the buffer
        throw ShapeError("pyre::mpi::alltoall: every process must supply one cell per process");
    }
    // room for the answer, one cell per process
    std::vector<cellT> answer(size());
    // exchange
    check(MPI_Alltoall(
        values.data(), 1, datatype<cellT>(), answer.data(), 1, datatype<cellT>(), handle()));
    // hand it off
    return answer;
}


// collect the payload of every process at {root}, in rank order
auto
pyre::mpi::Communicator::gatherBytes(const bytes_t & payload, rank_t root) const
    -> std::vector<bytes_t>
{
    // whether this process is the one that collects
    bool collecting = (rank() == root);
    // how many octets i bring
    int extent = static_cast<int>(payload.size());
    // tell {root} how many each of us brings; it cannot lay out its buffer without knowing
    auto counts = gather(extent, root);

    // where each process's octets will land in the buffer
    std::vector<int> displacements;
    // and the buffer itself; both matter only at {root}
    bytes_t buffer;
    // which is the only process that has to make room
    if (collecting) {
        // one displacement per process
        displacements.resize(counts.size());
        // laid end to end
        int total = 0;
        // in rank order
        for (decltype(counts.size()) slot = 0; slot < counts.size(); ++slot) {
            displacements[slot] = total;
            total += counts[slot];
        }
        // so the buffer holds every payload, back to back
        buffer.resize(total);
    }

    // move the octets
    check(MPI_Gatherv(
        payload.data(), extent, MPI_BYTE, collecting ? buffer.data() : nullptr,
        collecting ? counts.data() : nullptr, collecting ? displacements.data() : nullptr,
        MPI_BYTE, root, handle()));

    // cut the buffer back up into the payloads it was made of
    std::vector<bytes_t> collected;
    // again, only at {root}
    if (collecting) {
        // one payload per process
        collected.reserve(counts.size());
        // sliced at the displacements we computed
        for (decltype(counts.size()) slot = 0; slot < counts.size(); ++slot) {
            // the first octet of this process's contribution
            auto first = buffer.begin() + displacements[slot];
            // and the one past its last
            collected.emplace_back(first, first + counts[slot]);
        }
    }

    // hand them off; they are empty everywhere but {root}
    return collected;
}


// collect the payload of every process, and deliver the answer to every process
auto
pyre::mpi::Communicator::allgatherBytes(const bytes_t & payload) const -> std::vector<bytes_t>
{
    // how many octets i bring
    int extent = static_cast<int>(payload.size());
    // tell everybody how many each of us brings
    auto counts = allgather(extent);

    // where each process's octets will land in the buffer
    std::vector<int> displacements(counts.size());
    // laid end to end
    int total = 0;
    // in rank order
    for (decltype(counts.size()) slot = 0; slot < counts.size(); ++slot) {
        displacements[slot] = total;
        total += counts[slot];
    }

    // room for every payload, back to back
    bytes_t buffer(total);
    // move the octets
    check(MPI_Allgatherv(
        payload.data(), extent, MPI_BYTE, buffer.data(), counts.data(), displacements.data(),
        MPI_BYTE, handle()));

    // cut the buffer back up into the payloads it was made of
    std::vector<bytes_t> collected;
    // one per process
    collected.reserve(counts.size());
    // sliced at the displacements we computed
    for (decltype(counts.size()) slot = 0; slot < counts.size(); ++slot) {
        // the first octet of this process's contribution
        auto first = buffer.begin() + displacements[slot];
        // and the one past its last
        collected.emplace_back(first, first + counts[slot]);
    }

    // hand them off
    return collected;
}


// hand the nth payload of {payloads} to the nth process
auto
pyre::mpi::Communicator::scatterBytes(const std::vector<bytes_t> & payloads, rank_t root) const
    -> bytes_t
{
    // whether this process is the one that hands the payloads out
    bool distributing = (rank() == root);
    // {root} must have brought exactly one payload per process; nobody else's matters
    if (distributing && payloads.size() != static_cast<std::size_t>(size())) {
        // so refuse, rather than let mpi read past the end of the buffer
        throw ShapeError("pyre::mpi::scatterBytes: the root must supply one payload per process");
    }

    // how many octets each process is owed, and where its share begins
    std::vector<int> counts, displacements;
    // and the buffer they are packed into; all three matter only at {root}
    bytes_t outgoing;
    // which is the only process that has to pack anything
    if (distributing) {
        // one entry per process
        counts.resize(payloads.size());
        displacements.resize(payloads.size());
        // laid end to end
        int total = 0;
        // in rank order
        for (decltype(payloads.size()) slot = 0; slot < payloads.size(); ++slot) {
            counts[slot] = static_cast<int>(payloads[slot].size());
            displacements[slot] = total;
            total += counts[slot];
        }
        // so the buffer holds every payload, back to back
        outgoing.resize(total);
        // copied in, one at a time
        for (decltype(payloads.size()) slot = 0; slot < payloads.size(); ++slot) {
            std::copy(
                payloads[slot].begin(), payloads[slot].end(),
                outgoing.begin() + displacements[slot]);
        }
    }

    // tell each process how many octets are coming its way, since it must make room before the
    // octets themselves can move
    int extent = 0;
    // by scattering the counts
    check(MPI_Scatter(
        distributing ? counts.data() : nullptr, 1, MPI_INT, &extent, 1, MPI_INT, root, handle()));

    // make exactly that much room
    bytes_t incoming(extent);
    // and move the octets
    check(MPI_Scatterv(
        distributing ? outgoing.data() : nullptr, distributing ? counts.data() : nullptr,
        distributing ? displacements.data() : nullptr, MPI_BYTE, incoming.data(), extent, MPI_BYTE,
        root, handle()));

    // hand off my share
    return incoming;
}


// hand the nth payload of every process's {payloads} to the nth process
auto
pyre::mpi::Communicator::alltoallBytes(const std::vector<bytes_t> & payloads) const
    -> std::vector<bytes_t>
{
    // how many processes i hold
    auto processes = payloads.size();
    // every process must have brought exactly one payload per process
    if (processes != static_cast<std::size_t>(size())) {
        // so refuse, rather than let mpi read past the end of the buffer
        throw ShapeError("pyre::mpi::alltoallBytes: every process must supply one payload per "
                         "process");
    }

    // how many octets i am sending to each process, and where its share begins
    std::vector<int> sendCounts(processes), sendDisplacements(processes);
    // laid end to end
    int outgoingTotal = 0;
    // in rank order
    for (decltype(processes) slot = 0; slot < processes; ++slot) {
        sendCounts[slot] = static_cast<int>(payloads[slot].size());
        sendDisplacements[slot] = outgoingTotal;
        outgoingTotal += sendCounts[slot];
    }

    // pack them into one buffer, back to back
    bytes_t outgoing(outgoingTotal);
    // one at a time
    for (decltype(processes) slot = 0; slot < processes; ++slot) {
        std::copy(
            payloads[slot].begin(), payloads[slot].end(),
            outgoing.begin() + sendDisplacements[slot]);
    }

    // nobody can make room for what is coming without first learning how much it is, and each
    // process learns that from the process that is sending to it
    auto recvCounts = alltoall(sendCounts);

    // where each process's octets will land
    std::vector<int> recvDisplacements(processes);
    // laid end to end
    int incomingTotal = 0;
    // in rank order
    for (decltype(processes) slot = 0; slot < processes; ++slot) {
        recvDisplacements[slot] = incomingTotal;
        incomingTotal += recvCounts[slot];
    }

    // room for everything addressed to me
    bytes_t incoming(incomingTotal);
    // exchange
    check(MPI_Alltoallv(
        outgoing.data(), sendCounts.data(), sendDisplacements.data(), MPI_BYTE, incoming.data(),
        recvCounts.data(), recvDisplacements.data(), MPI_BYTE, handle()));

    // cut the buffer back up into the payloads it was made of
    std::vector<bytes_t> collected;
    // one per process
    collected.reserve(processes);
    // sliced at the displacements we computed
    for (decltype(processes) slot = 0; slot < processes; ++slot) {
        // the first octet of what this process sent me
        auto first = incoming.begin() + recvDisplacements[slot];
        // and the one past its last
        collected.emplace_back(first, first + recvCounts[slot]);
    }

    // hand them off
    return collected;
}


// point to point operations
// send {value} to {peer}, labelled with {tag}
template <typename cellT>
auto
pyre::mpi::Communicator::send(const cellT & value, rank_t peer, tag_t tag) const -> void
{
    // one cell, whose layout we deduce
    check(MPI_Send(&value, 1, datatype<cellT>(), peer, tag, handle()));
    // all done
    return;
}


// block until a matching message arrives from {peer}, and fill {value} with it
template <typename cellT>
auto
pyre::mpi::Communicator::recv(cellT & value, rank_t peer, tag_t tag) const -> Status
{
    // room for the report
    Status status;
    // receive exactly one cell
    check(MPI_Recv(&value, 1, datatype<cellT>(), peer, tag, handle(), status.raw()));
    // hand off the report
    return status;
}


// send a block of cells to {peer}
template <typename cellT>
auto
pyre::mpi::Communicator::send(const std::vector<cellT> & values, rank_t peer, tag_t tag) const
    -> void
{
    // ship the whole block; the receiver discovers its extent by probing
    check(MPI_Send(
        values.data(), static_cast<int>(values.size()), datatype<cellT>(), peer, tag, handle()));
    // all done
    return;
}


// block until a matching message arrives, sizing {values} to hold exactly what came
template <typename cellT>
auto
pyre::mpi::Communicator::recv(std::vector<cellT> & values, rank_t peer, tag_t tag) const -> Status
{
    // find out what is waiting for us, without taking it
    auto waiting = probe(peer, tag);
    // learn how many cells it holds
    auto cells = waiting.count<cellT>();
    // make room for exactly that many
    values.resize(cells);

    // room for the report
    Status status;
    // now take the message; name its sender and label explicitly rather than reusing the
    // wildcards, so that we receive the very message we just probed and not a later one
    check(MPI_Recv(
        values.data(), cells, datatype<cellT>(), waiting.source(), waiting.tag(), handle(),
        status.raw()));
    // hand off the report
    return status;
}


// send a raw payload to {peer}
auto
pyre::mpi::Communicator::sendBytes(const bytes_t & payload, rank_t peer, tag_t tag) const -> void
{
    // ship the bytes without interpreting them
    check(
        MPI_Send(payload.data(), static_cast<int>(payload.size()), MPI_BYTE, peer, tag, handle()));
    // all done
    return;
}


// block until a raw payload arrives, sizing the answer to hold exactly what came
auto
pyre::mpi::Communicator::recvBytes(rank_t peer, tag_t tag) const -> bytes_t
{
    // find out what is waiting for us, without taking it
    auto waiting = probe(peer, tag);
    // learn how many bytes it holds
    auto extent = waiting.count(MPI_BYTE);
    // make room for exactly that many
    bytes_t payload(extent);

    // room for the report, which nobody outside wants
    Status status;
    // take the message; as above, name the sender and label the probe found
    check(MPI_Recv(
        payload.data(), extent, MPI_BYTE, waiting.source(), waiting.tag(), handle(), status.raw()));
    // hand off the payload
    return payload;
}


// wait for a matching message to arrive, without receiving it
auto
pyre::mpi::Communicator::probe(rank_t peer, tag_t tag) const -> Status
{
    // room for the report
    Status status;
    // block until something matching shows up
    check(MPI_Probe(peer, tag, handle(), status.raw()));
    // hand off the report
    return status;
}


// ask whether a matching message has already arrived
auto
pyre::mpi::Communicator::iprobe(rank_t peer, tag_t tag) const -> std::optional<Status>
{
    // room for the report
    Status status;
    // and for mpi's answer
    int waiting = 0;
    // ask, without blocking
    check(MPI_Iprobe(peer, tag, handle(), &waiting, status.raw()));
    // when nothing matching has shown up yet
    if (!waiting) {
        // say so
        return std::nullopt;
    }
    // otherwise, describe what is waiting
    return status;
}


// send to one peer and receive from another in a single call
template <typename cellT>
auto
pyre::mpi::Communicator::sendrecv(
    const cellT & outgoing, rank_t destination, cellT & incoming, rank_t source, tag_t tag) const
    -> Status
{
    // room for the report
    Status status;
    // let mpi schedule both halves; a ring of these cannot deadlock, where a ring of matched
    // {send}/{recv} pairs can
    check(MPI_Sendrecv(
        &outgoing, 1, datatype<cellT>(), destination, tag, &incoming, 1, datatype<cellT>(), source,
        tag, handle(), status.raw()));
    // hand off the report
    return status;
}


// start sending {value} to {peer}
template <typename cellT>
auto
pyre::mpi::Communicator::isend(const cellT & value, rank_t peer, tag_t tag) const -> Request
{
    // room for the receipt
    Request::handle_type request = MPI_REQUEST_NULL;
    // start the transfer; {value} must outlive it, which is the caller's problem
    check(MPI_Isend(&value, 1, datatype<cellT>(), peer, tag, handle(), &request));
    // wrap the receipt and hand it off
    return Request(request);
}


// start receiving into {value}
template <typename cellT>
auto
pyre::mpi::Communicator::irecv(cellT & value, rank_t peer, tag_t tag) const -> Request
{
    // room for the receipt
    Request::handle_type request = MPI_REQUEST_NULL;
    // start the transfer; {value} must outlive it, which is the caller's problem
    check(MPI_Irecv(&value, 1, datatype<cellT>(), peer, tag, handle(), &request));
    // wrap the receipt and hand it off
    return Request(request);
}


// start shipping the {extent} octets at {data} to {peer}
auto
pyre::mpi::Communicator::isendBytes(
    const void * data, size_type extent, rank_t peer, tag_t tag) const -> Request
{
    // room for the receipt
    Request::handle_type request = MPI_REQUEST_NULL;
    // start the transfer; the buffer must stay put and stay alive until the receipt completes
    check(MPI_Isend(data, extent, MPI_BYTE, peer, tag, handle(), &request));
    // wrap the receipt and hand it off
    return Request(request);
}


// start receiving {extent} octets into {data}
auto
pyre::mpi::Communicator::irecvBytes(void * data, size_type extent, rank_t peer, tag_t tag) const
    -> Request
{
    // room for the receipt
    Request::handle_type request = MPI_REQUEST_NULL;
    // start the transfer; as above, the buffer belongs to the caller for the duration
    check(MPI_Irecv(data, extent, MPI_BYTE, peer, tag, handle(), &request));
    // wrap the receipt and hand it off
    return Request(request);
}


// process control
// bring down every process i hold
auto
pyre::mpi::Communicator::abort(int code) const -> void
{
    // ask mpi to take the job down; this call is not expected to return
    check(MPI_Abort(handle(), code));
    // all done, in the unlikely event we get here
    return;
}


