// code guard
#pragma once


// metamethods
// adopt an existing handle
pyre::mpi::Group::Group(handle_type handle, bool immortal) : _handle(handle, immortal) {}


// interface
// the raw token, for handing to the mpi c api
auto
pyre::mpi::Group::handle() const -> handle_type
{
    // ask my owner
    return _handle.handle();
}


// whether i name no group at all
auto
pyre::mpi::Group::isNull() const -> bool
{
    // compare against the token mpi reserves for exactly this
    return handle() == MPI_GROUP_NULL;
}


// whether i have no members
auto
pyre::mpi::Group::isEmpty() const -> bool
{
    // a group that does not exist has no members either, and asking mpi for the size of the
    // null handle is an error, so answer before we get there
    if (isNull()) {
        return true;
    }
    // otherwise, emptiness is a statement about membership, not about handle identity: mpi is
    // free to hand back a fresh empty group rather than the predefined {MPI_GROUP_EMPTY}
    return size() == 0;
}


// contextual conversion to {bool}
pyre::mpi::Group::operator bool() const
{
    // i am usable exactly when i name a group
    return !isNull();
}


// the rank of the calling process within me
auto
pyre::mpi::Group::rank() const -> rank_t
{
    // room for the answer
    rank_t rank = 0;
    // ask mpi; a process that is not a member gets {undefined} back, which is not an error
    check(MPI_Group_rank(handle(), &rank));
    // hand it off
    return rank;
}


// how many processes i hold
auto
pyre::mpi::Group::size() const -> size_type
{
    // room for the answer
    size_type size = 0;
    // ask mpi
    check(MPI_Group_size(handle(), &size));
    // hand it off
    return size;
}


// build the group that holds exactly the members named in {ranks}
auto
pyre::mpi::Group::include(const ranks_type & ranks) const -> Group
{
    // room for the new token
    handle_type group = MPI_GROUP_NULL;
    // build it; {data} is well defined on an empty vector, where the original {&ranks[0]} was
    // not, and mpi does not touch the array when the count is zero
    check(MPI_Group_incl(handle(), ranks.size(), ranks.data(), &group));
    // wrap the new token and hand it off
    return Group(group);
}


// build the group that holds all my members except those named in {ranks}
auto
pyre::mpi::Group::exclude(const ranks_type & ranks) const -> Group
{
    // room for the new token
    handle_type group = MPI_GROUP_NULL;
    // build it; as above, {data} is safe on an empty vector
    check(MPI_Group_excl(handle(), ranks.size(), ranks.data(), &group));
    // wrap the new token and hand it off
    return Group(group);
}


// how my membership relates to {other}'s
auto
pyre::mpi::Group::compare(const Group & other) const -> Comparison
{
    // room for the answer
    int result = MPI_UNEQUAL;
    // ask mpi
    check(MPI_Group_compare(handle(), other.handle(), &result));
    // translate its answer into one of my labels
    return comparison(result);
}


// the ranks that my members {ranks} carry in {other}
auto
pyre::mpi::Group::translateRanks(const ranks_type & ranks, const Group & other) const -> ranks_type
{
    // room for the answers, one per rank we were handed
    ranks_type translated(ranks.size(), undefined);
    // ask mpi; members of mine that {other} does not hold come back as {undefined}
    check(MPI_Group_translate_ranks(
        handle(), ranks.size(), ranks.data(), other.handle(), translated.data()));
    // hand them off
    return translated;
}


// the set operations; free functions, because neither argument is privileged
// the processes that belong to either group
auto
pyre::mpi::groupUnion(const Group & g1, const Group & g2) -> Group
{
    // room for the new token
    Group::handle_type group = MPI_GROUP_NULL;
    // build it
    check(MPI_Group_union(g1.handle(), g2.handle(), &group));
    // wrap the new token and hand it off
    return Group(group);
}


// the processes that belong to both groups
auto
pyre::mpi::groupIntersection(const Group & g1, const Group & g2) -> Group
{
    // room for the new token
    Group::handle_type group = MPI_GROUP_NULL;
    // build it
    check(MPI_Group_intersection(g1.handle(), g2.handle(), &group));
    // wrap the new token and hand it off
    return Group(group);
}


// the processes of the first group that do not belong to the second
auto
pyre::mpi::groupDifference(const Group & g1, const Group & g2) -> Group
{
    // room for the new token
    Group::handle_type group = MPI_GROUP_NULL;
    // build it
    check(MPI_Group_difference(g1.handle(), g2.handle(), &group));
    // wrap the new token and hand it off
    return Group(group);
}


