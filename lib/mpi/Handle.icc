// code guard
#pragma once


// metamethods
// adopt {handle}, choosing the deleter that matches its mortality
template <class traitsT>
pyre::mpi::Handle<traitsT>::Handle(handle_type handle, bool immortal) :
    _handle(new handle_type(handle), immortal ? &Handle::_abandon : &Handle::_reclaim)
{}


// interface
// the raw token, for handing to the mpi c api
template <class traitsT>
auto
pyre::mpi::Handle<traitsT>::handle() const -> handle_type
{
    // reach into the box
    return *_handle;
}


// the number of owners that currently share my token
template <class traitsT>
auto
pyre::mpi::Handle<traitsT>::references() const -> long
{
    // ask the shared pointer
    return _handle.use_count();
}


// implementation details
// give the token back to mpi and destroy its box
template <class traitsT>
auto
pyre::mpi::Handle<traitsT>::_reclaim(handle_type * box) noexcept -> void
{
    // mpi can only take a handle back while its runtime is up; once it is down, everything it
    // ever handed out went down with it, so there is nothing left to release. this is what
    // lets an interpreter tear down its objects in any order it likes after {finalize}
    if (initialized() && !finalized()) {
        // hand the token back
        traits_type::free(*box);
    }

    // in either case, the box is ours
    delete box;

    // all done
    return;
}


// destroy the box but leave the token alone
template <class traitsT>
auto
pyre::mpi::Handle<traitsT>::_abandon(handle_type * box) noexcept -> void
{
    // the token belongs to mpi, and outlives us; only the box is ours
    delete box;

    // all done
    return;
}


// end of file
