// code guard
#pragma once


// my declarations
#include "Status.h"

// the {check} that turns a failed mpi status into an exception
#include "Error.h"
// the deduction of the layout of the cells i counted
#include "datatypes.h"


// metamethods
// build an empty status, ready to be handed to a receive
pyre::mpi::Status::Status() : _status {} {}


// adopt a status that mpi has already filled in
pyre::mpi::Status::Status(const raw_type & status) : _status(status) {}


// interface
// the rank of the process that sent the message
auto
pyre::mpi::Status::source() const -> rank_t
{
    // mpi exposes this one as a plain field
    return _status.MPI_SOURCE;
}


// the label the message carried
auto
pyre::mpi::Status::tag() const -> tag_t
{
    // another plain field
    return _status.MPI_TAG;
}


// whether the transfer itself failed
auto
pyre::mpi::Status::error() const -> int
{
    // and a third
    return _status.MPI_ERROR;
}


// whether the transfer was cancelled before it could complete
auto
pyre::mpi::Status::cancelled() const -> bool
{
    // room for the answer
    int flag = 0;
    // only mpi knows; cancellation is not a field of the struct
    check(MPI_Test_cancelled(&_status, &flag));
    // hand it off
    return flag != 0;
}


// how many cells of type {cellT} the message held
template <typename cellT>
auto
pyre::mpi::Status::count() const -> size_type
{
    // deduce the layout and ask
    return count(datatype<cellT>());
}


// how many cells of the given layout the message held
auto
pyre::mpi::Status::count(datatype_t type) const -> size_type
{
    // room for the answer
    size_type cells = 0;
    // only mpi knows how many cells arrived; the count is not a field of the struct
    check(MPI_Get_count(&_status, type, &cells));
    // hand it off
    return cells;
}


// the underlying struct, for handing to the mpi c api
auto
pyre::mpi::Status::raw() -> raw_type *
{
    // point at my struct so mpi can fill it in
    return &_status;
}


// the same, for callers that only read
auto
pyre::mpi::Status::raw() const -> const raw_type *
{
    // point at my struct
    return &_status;
}


// end of file
